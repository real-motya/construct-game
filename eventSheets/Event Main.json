{
	"name": "Event Main",
	"events": [
		{
			"eventType": "block",
			"conditions": [
				{
					"id": "on-start-of-layout",
					"objectClass": "System",
					"sid": 135430325690594
				}
			],
			"actions": [
				{
					"type": "script",
					"language": "javascript",
					"script": [
						"// ==========================================",
						"// РОУТЕР ВВОДА (общий для всех макетов, инициализируется один раз)",
						"// ==========================================",
						"if (typeof globalThis.gameEngineInitialized === \"undefined\") {",
						"    globalThis.gameEngineInitialized = true;",
						"    globalThis.gameInventory = [];",
						"    globalThis.gameKeys = new Set();",
						"",
						"    runtime.addEventListener(\"keydown\", e => {",
						"        globalThis.gameKeys.add(e.code);",
						"        if (globalThis.currentLayoutKeyDown) globalThis.currentLayoutKeyDown(e);",
						"    });",
						"    runtime.addEventListener(\"keyup\", e => globalThis.gameKeys.delete(e.code));",
						"    runtime.addEventListener(\"pointerdown\", e => {",
						"        if (globalThis.currentLayoutPointerDown) globalThis.currentLayoutPointerDown(e);",
						"    });",
						"    runtime.addEventListener(\"tick\", () => {",
						"        if (globalThis.currentLayoutTick) globalThis.currentLayoutTick();",
						"    });",
						"}",
						"",
						"// Состояние уровней (живёт между переходами макетов):",
						"//   removed   - ключи убранных объектов (побеждённые враги, подобранные предметы, открытые двери)",
						"//   returnPos - где стоял игрок перед уходом в бой",
						"globalThis.levelState = globalThis.levelState || {};",
						"",
						"// Сброс обработчиков предыдущего макета",
						"globalThis.currentLayoutTick = null;",
						"globalThis.currentLayoutKeyDown = null;",
						"globalThis.currentLayoutPointerDown = null;",
						"globalThis.gameKeys.clear();",
						"",
						"// ==========================================",
						"// НАСТРОЙКИ",
						"// ==========================================",
						"const INTERACT_CODE = \"KeyE\";      // клавиша взаимодействия",
						"const INTERACT_LABEL = \"E\";        // текст подсказки над объектом",
						"const BATTLE_LAYOUT = \"Battle\";    // имя макета боя",
						"const HINT_LAYER = \"GUI\";          // слой подсказки (она всегда поверх игры)",
						"const HINT_FONT_PT = 6;            // размер шрифта подсказки (null = как в объекте HintText)",
						"const TILE = 8;",
						"const DEBUG = false;               // true = служебные сообщения в консоль",
						"",
						"const LEVEL_STARTS = {",
						"    \"Level_0\": { x: 16, y: 32 },",
						"    \"Level_1\": { x: 16, y: 56 }",
						"};",
						"",
						"// Всё, с чем можно взаимодействовать по клавише",
						"const INTERACTABLE_TYPES = [\"Inspectable\", \"Samopicec\", \"broken_satellite\", \"NPC\", \"Door\", \"Enemy\"];",
						"",
						"// Объекты интерфейса, которые прячутся при старте макета",
						"// (Death*/Respawn*/Exit* остались от старой системы боя)",
						"const HIDDEN_ON_START = [",
						"    \"abyss\",",
						"    \"DialogPanel\", \"DialogText\", \"DialogNameText\", \"DialogChoice1\", \"DialogChoice2\",",
						"    \"Choice1Text\", \"Choice2Text\", \"DialogCursor\",",
						"    \"DeathPanel\", \"DeathTitleText\", \"RespawnButton\", \"ExitButton\", \"RespawnText\", \"ExitText\", \"DeathCursor\"",
						"];",
						"",
						"const log = (...args) => { if (DEBUG) console.log(...args); };",
						"",
						"const player = runtime.objects.Player ? runtime.objects.Player.getFirstInstance() : null;",
						"if (!player) {",
						"    console.warn(\"Объект Player не найден: поставьте спрайт Player на этот макет.\");",
						"} else {",
						"    initLevel(player);",
						"}",
						"",
						"function initLevel(player) {",
						"    const layoutName = runtime.layout.name;",
						"    const inventory = globalThis.gameInventory;",
						"    const keys = globalThis.gameKeys;",
						"    const tm = player.behaviors.TileMovement;",
						"",
						"    // ------------------------------------------",
						"    // Персистентность объектов уровня",
						"    // ------------------------------------------",
						"    if (!globalThis.levelState[layoutName]) {",
						"        globalThis.levelState[layoutName] = { removed: new Set(), returnPos: null };",
						"    }",
						"    const state = globalThis.levelState[layoutName];",
						"",
						"    // Статичные объекты не двигаются",
						"    const entityKey = inst => `${inst.objectType.name}@${Math.round(inst.x)},${Math.round(inst.y)}`;",
						"    const markRemoved = inst => state.removed.add(entityKey(inst));",
						"",
						"    const liveCache = {};",
						"    function getLive(typeName) {",
						"        if (liveCache[typeName]) return liveCache[typeName];",
						"        const type = runtime.objects[typeName];",
						"        const alive = [];",
						"        if (type) {",
						"            for (const inst of type.getAllInstances()) {",
						"                if (state.removed.has(entityKey(inst))) inst.destroy();",
						"                else alive.push(inst);",
						"            }",
						"        }",
						"        return (liveCache[typeName] = alive);",
						"    }",
						"",
						"    // ------------------------------------------",
						"    // Объекты уровня и интерфейс",
						"    // ------------------------------------------",
						"    const items = getLive(\"Item\");",
						"    const interactables = INTERACTABLE_TYPES.flatMap(getLive);",
						"    const abysses = runtime.objects.abyss ? runtime.objects.abyss.getAllInstances() : [];",
						"",
						"    const first = name => runtime.objects[name] ? runtime.objects[name].getFirstInstance() : null;",
						"    const hud = first(\"HUDText\");",
						"    const ui = {",
						"        panel: first(\"DialogPanel\"), text: first(\"DialogText\"), name: first(\"DialogNameText\"),",
						"        choice1: first(\"DialogChoice1\"), choice1Text: first(\"Choice1Text\"),",
						"        choice2: first(\"DialogChoice2\"), choice2Text: first(\"Choice2Text\"),",
						"        cursor: first(\"DialogCursor\")",
						"    };",
						"    const setUi = (inst, visible, text) => {",
						"        if (!inst) return;",
						"        inst.isVisible = visible;",
						"        if (text !== undefined) inst.text = text;",
						"    };",
						"",
						"    for (const name of HIDDEN_ON_START) {",
						"        const type = runtime.objects[name];",
						"        if (type) for (const inst of type.getAllInstances()) inst.isVisible = false;",
						"    }",
						"    if (hud) hud.isVisible = true;",
						"",
						"    const wrongLayer = new Set();",
						"    for (const obj of [...interactables, ...items]) {",
						"        if (obj.layer.name !== player.layer.name) wrongLayer.add(`${obj.objectType.name} (слой ${obj.layer.name})`);",
						"    }",
						"    if (wrongLayer.size) {",
						"        console.warn(`Объекты стоят не на слое игрока \"${player.layer.name}\": ${[...wrongLayer].join(\", \")}. ` +",
						"            \"Перенесите их на этот слой, иначе взаимодействие с ними работать не будет.\");",
						"    }",
						"",
						"    let hint = null;",
						"    if (runtime.objects.HintText) {",
						"        const hintType = runtime.objects.HintText;",
						"        for (const inst of hintType.getAllInstances()) inst.destroy();",
						"        const hintLayer = runtime.layout.getLayer(HINT_LAYER) || player.layer;",
						"        hint = hintType.createInstance(hintLayer.name, 0, 0);",
						"        hint.text = INTERACT_LABEL;",
						"        hint.horizontalAlign = \"center\";",
						"        hint.width = TILE * 2;",
						"        hint.height = TILE * 2;",
						"        if (HINT_FONT_PT) hint.sizePt = HINT_FONT_PT;",
						"        hint.isVisible = false;",
						"        hint.moveToTop();",
						"    } else {",
						"        console.warn(\"Объект HintText не найден: подсказки над объектами показываться не будут.\");",
						"    }",
						"",
						"    // ------------------------------------------",
						"    // Стартовая позиция",
						"    // ------------------------------------------",
						"    const spawn = state.returnPos || LEVEL_STARTS[layoutName];",
						"    state.returnPos = null;",
						"    if (spawn) {",
						"        tm.isEnabled = false;",
						"        player.setPosition(spawn.x, spawn.y);",
						"        player.moveToTop();",
						"        tm.isEnabled = true;",
						"    }",
						"",
						"    // ------------------------------------------",
						"    // Состояние",
						"    // ------------------------------------------",
						"    let isDialogOpen = false;",
						"    let dialogChoices = null;",
						"    let speaker = \"\";",
						"    let selected = 0;",
						"    let nearAbyss = false;",
						"    let leaving = false;",
						"    let facingX = 0;",
						"    let facingY = 1;",
						"    let inputCooldown = 0.3;",
						"    let lastHintObj = null;",
						"",
						"    const isUp = code => code === \"ArrowUp\" || code === \"KeyW\";",
						"    const isDown = code => code === \"ArrowDown\" || code === \"KeyS\";",
						"    const isConfirm = e => !e.repeat && (e.code === \"Enter\" || e.code === \"Space\" || e.code === INTERACT_CODE);",
						"",
						"    // ------------------------------------------",
						"    // Диалоги",
						"    // ------------------------------------------",
						"    const DIALOG_DATABASE = {",
						"        \"samopicec_1\": { name: \"...\", text: \"...\" },",
						"        \"broken_satellite\": { name: \"...\", text: \"...\" },",
						"        \"npc_1\": {",
						"            name: \"ЧЛЕН ПАРТИИ\",",
						"            text: \"Привет. Ты в норме?\",",
						"            choices: [",
						"                {",
						"                    label: \"Да.\",",
						"                    action: () => openDialog(\"Я бы так не сказал.\", [",
						"                        { label: \"Хорошо.\", action: () => openDialog(\"Ну-ну.\") },",
						"                        { label: \"Чего?\", action: () => openDialog(\"...\") }",
						"                    ])",
						"                },",
						"                { label: \"Нет.\", action: () => openDialog(\"Ага, по тебе видно.\") }",
						"            ]",
						"        }",
						"    };",
						"",
						"    function moveCursor() {",
						"        const target = selected === 0 ? ui.choice1 : ui.choice2;",
						"        if (!ui.cursor || !target) return;",
						"        ui.cursor.y = target.y;",
						"        ui.cursor.x = target.getBoundingBox().left - 10;",
						"    }",
						"",
						"    function openDialog(text = \"Null\", choices = null) {",
						"        if (isDialogOpen) return;",
						"        isDialogOpen = true;",
						"        dialogChoices = choices;",
						"        keys.clear();",
						"        inputCooldown = 0.2;",
						"        if (hint) hint.isVisible = false;",
						"",
						"        const c = choices || [];",
						"        setUi(ui.panel, true);",
						"        setUi(ui.text, true, text);",
						"        setUi(ui.name, Boolean(speaker), speaker);",
						"        setUi(ui.choice1, c.length > 0);",
						"        setUi(ui.choice1Text, c.length > 0, c[0]?.label ?? \"Да\");",
						"        setUi(ui.choice2, c.length > 1);",
						"        setUi(ui.choice2Text, c.length > 1, c[1]?.label ?? \"Нет\");",
						"        setUi(ui.cursor, c.length > 0);",
						"        selected = 0;",
						"        if (c.length > 0) moveCursor();",
						"    }",
						"",
						"    function closeDialog() {",
						"        if (!isDialogOpen) return;",
						"        isDialogOpen = false;",
						"        dialogChoices = null;",
						"        keys.clear();",
						"        inputCooldown = 0.2;",
						"        for (const inst of Object.values(ui)) setUi(inst, false);",
						"    }",
						"",
						"    function pickChoice(index) {",
						"        const action = dialogChoices?.[index]?.action;",
						"        closeDialog();",
						"        if (action) action();",
						"    }",
						"",
						"    // ------------------------------------------",
						"    // Взаимодействие",
						"    // ------------------------------------------",
						"",
						"    function findInteractionTarget() {",
						"        const checkX = player.x + facingX * TILE;",
						"        const checkY = player.y + facingY * TILE;",
						"",
						"        let best = null;",
						"        let bestDist = Infinity;",
						"        for (const obj of interactables) {",
						"            const d = Math.hypot(checkX - obj.x, checkY - obj.y);",
						"            if (d <= TILE * 1.5 && d < bestDist) { best = obj; bestDist = d; }",
						"        }",
						"        if (best) return { kind: \"object\", obj: best };",
						"",
						"        bestDist = Infinity;",
						"        for (const item of items) {",
						"            const d = Math.hypot(player.x - item.x, player.y - item.y);",
						"            if (d <= TILE * 1.2 && d < bestDist) { best = item; bestDist = d; }",
						"        }",
						"        return best ? { kind: \"item\", obj: best } : null;",
						"    }",
						"",
						"    function startBattle(enemy) {",
						"        state.returnPos = { x: player.x, y: player.y };",
						"        globalThis.battleContext = {",
						"            enemyKey: entityKey(enemy),",
						"            enemyType: enemy.instVars?.EnemyType || \"default\",",
						"            returnLayout: layoutName,",
						"            background: layoutName",
						"        };",
						"        leaving = true;",
						"        keys.clear();",
						"        runtime.goToLayout(BATTLE_LAYOUT);",
						"    }",
						"",
						"    function removeObject(obj, list) {",
						"        markRemoved(obj);",
						"        obj.destroy();",
						"        const i = list.indexOf(obj);",
						"        if (i !== -1) list.splice(i, 1);",
						"    }",
						"",
						"    function interact({ kind, obj }) {",
						"        if (kind === \"item\") {",
						"            inventory.push(obj.instVars.ItemType);",
						"            removeObject(obj, items);",
						"            return;",
						"        }",
						"",
						"        if (obj.objectType.name === \"Enemy\") {",
						"            speaker = \"ДЕЙСТВИЕ\";",
						"            openDialog(\"Начать бой?\", [",
						"                { label: \"Да\", action: () => startBattle(obj) },",
						"                { label: \"Нет\", action: () => {} }",
						"            ]);",
						"            return;",
						"        }",
						"",
						"        // Объект с замком (дверь)",
						"        if (obj.instVars && obj.instVars.requiredItem !== undefined) {",
						"            const required = obj.instVars.requiredItem;",
						"            speaker = \"ДЕЙСТВИЕ\";",
						"            if (inventory.includes(required)) {",
						"                openDialog(`Доступ разрешен.\\nИспользован: ${required}`);",
						"                removeObject(obj, interactables);",
						"            } else {",
						"                openDialog(`Заперто.\\nНеобходим предмет: ${required}`);",
						"            }",
						"            return;",
						"        }",
						"",
						"        // Остальное: диалоги",
						"        const data = DIALOG_DATABASE[obj.instVars?.dialogId || \"default\"];",
						"        if (!data) { speaker = \"ОШИБКА\"; openDialog(\"Запись повреждена.\"); return; }",
						"        if (typeof data === \"string\") { speaker = \"НЕИЗВЕСТНО\"; openDialog(data); return; }",
						"        speaker = data.name || \"\";",
						"        openDialog(data.text, data.choices);",
						"    }",
						"",
						"    function updateHint() {",
						"        if (!hint) return;",
						"        const target = (!isDialogOpen && !tm.isMoving) ? findInteractionTarget() : null;",
						"        if (!target) { hint.isVisible = false; lastHintObj = null; return; }",
						"",
						"        const obj = target.obj;",
						"        if (DEBUG && obj !== lastHintObj) log(\"Подсказка:\", obj.objectType.name, \"слой\", obj.layer.name);",
						"        lastHintObj = obj;",
						"",
						"        const bb = obj.getBoundingBox();",
						"        const cx = (bb.left + bb.right) / 2;",
						"        const toHintLayer = wy => hint.layer.cssPxToLayer(...obj.layer.layerToCssPx(cx, wy));",
						"        const [hx, hyTop] = toHintLayer(bb.top);",
						"",
						"        hint.setPosition(hx, hyTop);",
						"        let hb = hint.getBoundingBox();",
						"        hint.x += hx - (hb.left + hb.right) / 2;      // по центру объекта",
						"        hint.y += (hyTop - 1) - hb.bottom;            // над объектом (не зависит от точки привязки)",
						"",
						"        hb = hint.getBoundingBox();",
						"        if (hb.top < hint.layer.getViewport().top) {",
						"            const [, hyBottom] = toHintLayer(bb.bottom);",
						"            hint.y += (hyBottom + 1) - hb.top;",
						"        }",
						"        hint.isVisible = true;",
						"    }",
						"",
						"    // ------------------------------------------",
						"    // Пропасть, движение, камера",
						"    // ------------------------------------------",
						"    function checkAbyss() {",
						"        let near = false;",
						"        for (const abyss of abysses) {",
						"            const bb = abyss.getBoundingBox();",
						"            const nx = Math.max(bb.left, Math.min(player.x, bb.right));",
						"            const ny = Math.max(bb.top, Math.min(player.y, bb.bottom));",
						"            if (Math.hypot(player.x - nx, player.y - ny) <= TILE * 1.2) { near = true; break; }",
						"        }",
						"        if (near && !nearAbyss) {",
						"            speaker = \"ДЕЙСТВИЕ\";",
						"            openDialog(\"Прыгнуть?\", [",
						"                { label: \"Да\", action: () => runtime.goToLayout(\"Level_1\") },",
						"                { label: \"Нет\", action: () => {} }",
						"            ]);",
						"        }",
						"        nearAbyss = near;",
						"    }",
						"",
						"    const MOVES = [",
						"        { codes: [\"ArrowLeft\", \"KeyA\"],  dir: \"left\",  fx: -1, fy: 0 },",
						"        { codes: [\"ArrowRight\", \"KeyD\"], dir: \"right\", fx: 1,  fy: 0 },",
						"        { codes: [\"ArrowUp\", \"KeyW\"],    dir: \"up\",    fx: 0,  fy: -1 },",
						"        { codes: [\"ArrowDown\", \"KeyS\"],  dir: \"down\",  fx: 0,  fy: 1 }",
						"    ];",
						"    function handleMovement() {",
						"        if (inputCooldown > 0) return;",
						"        const move = MOVES.find(m => m.codes.some(code => keys.has(code)));",
						"        if (!move) return;",
						"        facingX = move.fx;",
						"        facingY = move.fy;",
						"        tm.simulateControl(move.dir);",
						"    }",
						"",
						"    function followCamera(dt) {",
						"        const k = 5 * dt;",
						"        const x = runtime.layout.scrollX;",
						"        const y = runtime.layout.scrollY;",
						"        runtime.layout.scrollTo(Math.round(x + (player.x - x) * k), Math.round(y + (player.y - y) * k));",
						"    }",
						"",
						"    // ------------------------------------------",
						"    // Обработчики",
						"    // ------------------------------------------",
						"    globalThis.currentLayoutTick = () => {",
						"        if (leaving) return;",
						"        const dt = runtime.dt;",
						"        inputCooldown = Math.max(0, inputCooldown - dt);",
						"        if (isDialogOpen) return;",
						"",
						"        if (hud) hud.text = \"INV: \" + inventory.join(\", \");",
						"        checkAbyss();",
						"        handleMovement();",
						"        updateHint();",
						"        followCamera(dt);",
						"    };",
						"",
						"    globalThis.currentLayoutKeyDown = e => {",
						"        if (leaving || inputCooldown > 0) return;",
						"",
						"        if (isDialogOpen) {",
						"            if (e.code === \"Escape\") closeDialog();",
						"            else if (dialogChoices && dialogChoices.length > 0) {",
						"                if (isUp(e.code)) { selected = 0; moveCursor(); }",
						"                else if (isDown(e.code) && dialogChoices.length > 1) { selected = 1; moveCursor(); }",
						"                else if (isConfirm(e)) pickChoice(selected);",
						"            } else if (isConfirm(e)) closeDialog();",
						"            return;",
						"        }",
						"",
						"        if (e.code === INTERACT_CODE && !e.repeat) {",
						"            const target = findInteractionTarget();",
						"            if (target) interact(target);",
						"        }",
						"    };",
						"",
						"    globalThis.currentLayoutPointerDown = e => {",
						"        if (e.button !== 0 || leaving || inputCooldown > 0 || !isDialogOpen) return;",
						"        if (!dialogChoices || dialogChoices.length === 0) return closeDialog();",
						"",
						"        [ui.choice1, ui.choice2].forEach((choice, i) => {",
						"            if (!choice || !choice.isVisible || !isDialogOpen) return;",
						"            const [x, y] = choice.layer.cssPxToLayer(e.clientX, e.clientY);",
						"            if (choice.containsPoint(x, y)) pickChoice(i);",
						"        });",
						"    };",
						"",
						"    log(\"Макет запущен:\", layoutName);",
						"}"
					]
				}
			],
			"sid": 897819424656422
		}
	],
	"sid": 951204323471381
}