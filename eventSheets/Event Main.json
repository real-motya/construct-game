{
	"name": "Event Main",
	"events": [
		{
			"eventType": "block",
			"conditions": [
				{
					"id": "on-start-of-layout",
					"objectClass": "System",
					"sid": 135430325690594
				}
			],
			"actions": [
				{
					"type": "script",
					"language": "javascript",
					"script": [
						"// ==========================================",
						"// РОУТЕР ВВОДА (общий для всех макетов, инициализируется один раз)",
						"// ==========================================",
						"if (typeof globalThis.gameEngineInitialized === \"undefined\") {",
						"    globalThis.gameEngineInitialized = true;",
						"    globalThis.gameInventory = [];",
						"    globalThis.gameKeys = new Set();",
						"",
						"    runtime.addEventListener(\"keydown\", e => {",
						"        globalThis.gameKeys.add(e.code);",
						"        if (globalThis.currentLayoutKeyDown) globalThis.currentLayoutKeyDown(e);",
						"    });",
						"    runtime.addEventListener(\"keyup\", e => globalThis.gameKeys.delete(e.code));",
						"    runtime.addEventListener(\"pointerdown\", e => {",
						"        if (globalThis.currentLayoutPointerDown) globalThis.currentLayoutPointerDown(e);",
						"    });",
						"    runtime.addEventListener(\"tick\", () => {",
						"        if (globalThis.currentLayoutTick) globalThis.currentLayoutTick();",
						"    });",
						"}",
						"",
						"// Состояние уровней (живёт между переходами макетов):",
						"//   removed   - ключи убранных объектов (побеждённые враги, подобранные предметы, открытые двери)",
						"//   returnPos - где стоял игрок перед уходом в бой",
						"globalThis.levelState = globalThis.levelState || {};",
						"",
						"// Сброс обработчиков предыдущего макета",
						"globalThis.currentLayoutTick = null;",
						"globalThis.currentLayoutKeyDown = null;",
						"globalThis.currentLayoutPointerDown = null;",
						"globalThis.gameKeys.clear();",
						"",
						"// ==========================================",
						"// НАСТРОЙКИ",
						"// ==========================================",
						"const INTERACT_CODE = \"KeyE\";      // клавиша взаимодействия",
						"const INTERACT_LABEL = \"E\";        // текст подсказки над объектом",
						"const BATTLE_LAYOUT = \"Battle\";    // имя макета боя",
						"const HINT_LAYER = \"GUI\";          // слой подсказки (она всегда поверх игры)",
						"const HINT_FONT_PT = 6;            // размер шрифта подсказки (null = как в объекте HintText)",
						"const TILE = 8;",
						"const DEBUG = false;               // true = служебные сообщения в консоль",
						"const INV_KEY = \"KeyI\";            // клавиша открытия/закрытия инвентаря",
						"const INV_UI = {",
						"    x: 16, y: 12, w: 128, h: 120,  // координаты и размер окна (под экран 160x144)",
						"    fontPt: 6,",
						"    hintFontPt: 3,                 // размер шрифта нижней подсказки",
						"    textPad: 4,",
						"    lineHeight: 11,",
						"    maxVisible: 7,                 // сколько строк помещается в окне одновременно",
						"    colors: {",
						"        border: [1, 1, 1],",
						"        bg:     [0.04, 0.05, 0.04],",
						"        title:  [1, 0.85, 0.2],",
						"        text:   [1, 1, 1],",
						"        select: [1, 0.85, 0.2],",
						"        hint:   [0.6, 0.6, 0.6]",
						"    }",
						"};",
						"",
						"const DIALOG_UI = {",
						"    x: 4, y: 88, w: 152, h: 52,   // окно диалога внизу экрана (под экран 160x144)",
						"    fontPt: 6,",
						"    textPad: 4,",
						"    maxCharsPerLine: 20,           // сколько символов влезает в одну строку",
						"    maxLines: 3,                   // сколько строк помещается в окно за один раз",
						"    colors: {",
						"        border: [1, 1, 1],",
						"        bg:     [0.04, 0.05, 0.04],",
						"        name:   [1, 0.85, 0.2],",
						"        text:   [1, 1, 1],",
						"        select: [1, 0.85, 0.2]",
						"    }",
						"};",
						"",
						"// Объекты интерфейса, которые прячутся при старте макета",
						"// (Death*/Respawn*/Exit* остались от старой системы боя)",
						"const HIDDEN_ON_START = [",
						"    \"abyss\",",
						"    \"DeathPanel\", \"DeathTitleText\", \"RespawnButton\", \"ExitButton\", \"RespawnText\", \"ExitText\", \"DeathCursor\"",
						"];",
						"",
						"const LEVEL_STARTS = {",
						"    \"Level_0\": { x: 16, y: 32 },",
						"    \"Level_1\": { x: 16, y: 56 }",
						"};",
						"",
						"// Всё, с чем можно взаимодействовать по клавише",
						"const INTERACTABLE_TYPES = [\"Inspectable\", \"Samopicec\", \"broken_satellite\", \"NPC\", \"Door\", \"Enemy\"];",
						"",
						"",
						"const log = (...args) => { if (DEBUG) console.log(...args); };",
						"",
						"const player = runtime.objects.Player ? runtime.objects.Player.getFirstInstance() : null;",
						"if (!player) {",
						"    console.warn(\"Объект Player не найден: поставьте спрайт Player на этот макет.\");",
						"} else {",
						"    initLevel(player);",
						"}",
						"",
						"function initLevel(player) {",
						"    const layoutName = runtime.layout.name;",
						"    const inventory = globalThis.gameInventory;",
						"    const keys = globalThis.gameKeys;",
						"    const tm = player.behaviors.TileMovement;",
						"",
						"    // ------------------------------------------",
						"    // Персистентность объектов уровня",
						"    // ------------------------------------------",
						"    if (!globalThis.levelState[layoutName]) {",
						"        globalThis.levelState[layoutName] = { removed: new Set(), returnPos: null };",
						"    }",
						"    const state = globalThis.levelState[layoutName];",
						"",
						"    // Статичные объекты не двигаются",
						"    const entityKey = inst => `${inst.objectType.name}@${Math.round(inst.x)},${Math.round(inst.y)}`;",
						"    const markRemoved = inst => state.removed.add(entityKey(inst));",
						"",
						"    const liveCache = {};",
						"    function getLive(typeName) {",
						"        if (liveCache[typeName]) return liveCache[typeName];",
						"        const type = runtime.objects[typeName];",
						"        const alive = [];",
						"        if (type) {",
						"            for (const inst of type.getAllInstances()) {",
						"                if (state.removed.has(entityKey(inst))) inst.destroy();",
						"                else alive.push(inst);",
						"            }",
						"        }",
						"        return (liveCache[typeName] = alive);",
						"    }",
						"",
						"    // ------------------------------------------",
						"    // Объекты уровня и интерфейс",
						"    // ------------------------------------------",
						"    const items = getLive(\"Item\");",
						"    const interactables = INTERACTABLE_TYPES.flatMap(getLive);",
						"    const abysses = runtime.objects.abyss ? runtime.objects.abyss.getAllInstances() : [];",
						"",
						"    const first = name => runtime.objects[name] ? runtime.objects[name].getFirstInstance() : null;",
						"",
						"    for (const name of HIDDEN_ON_START) {",
						"        const type = runtime.objects[name];",
						"        if (type) for (const inst of type.getAllInstances()) inst.isVisible = false;",
						"    }",
						"",
						"    const wrongLayer = new Set();",
						"    for (const obj of [...interactables, ...items]) {",
						"        if (obj.layer.name !== player.layer.name) wrongLayer.add(`${obj.objectType.name} (слой ${obj.layer.name})`);",
						"    }",
						"    if (wrongLayer.size) {",
						"        console.warn(`Объекты стоят не на слое игрока \"${player.layer.name}\": ${[...wrongLayer].join(\", \")}. ` +",
						"            \"Перенесите их на этот слой, иначе взаимодействие с ними работать не будет.\");",
						"    }",
						"",
						"    let hint = null;",
						"    if (runtime.objects.HintText) {",
						"        const hintType = runtime.objects.HintText;",
						"        for (const inst of hintType.getAllInstances()) inst.destroy();",
						"        const hintLayer = runtime.layout.getLayer(HINT_LAYER) || player.layer;",
						"        hint = hintType.createInstance(hintLayer.name, 0, 0);",
						"        hint.text = INTERACT_LABEL;",
						"        hint.horizontalAlign = \"center\";",
						"        hint.width = TILE * 2;",
						"        hint.height = TILE * 2;",
						"        if (HINT_FONT_PT) hint.sizePt = HINT_FONT_PT;",
						"        hint.isVisible = false;",
						"        hint.moveToTop();",
						"    } else {",
						"        console.warn(\"Объект HintText не найден: подсказки над объектами показываться не будут.\");",
						"    }",
						"",
						"    // ------------------------------------------",
						"    // Стартовая позиция",
						"    // ------------------------------------------",
						"    const spawn = state.returnPos || LEVEL_STARTS[layoutName];",
						"    const savedFacing = state.returnFacing || null;",
						"    state.returnPos = null;",
						"    state.returnFacing = null;",
						"    if (spawn) {",
						"        tm.isEnabled = false;",
						"        player.setPosition(spawn.x, spawn.y);",
						"        player.moveToTop();",
						"        tm.isEnabled = true;",
						"    }",
						"",
						"    // ------------------------------------------",
						"    // Состояние",
						"    // ------------------------------------------",
						"    let isDialogOpen = false;",
						"    let dialogChoices = null;",
						"    let speaker = \"\";",
						"    let selected = 0;",
						"    let nearAbyss = false;",
						"    let leaving = false;",
						"    let facingX = savedFacing ? savedFacing.x : 0;",
						"    let facingY = savedFacing ? savedFacing.y : 1;",
						"    let inputCooldown = 0.3;",
						"    let lastHintObj = null;",
						"",
						"    const isUp = code => code === \"ArrowUp\" || code === \"KeyW\";",
						"    const isDown = code => code === \"ArrowDown\" || code === \"KeyS\";",
						"    const isConfirm = e => !e.repeat && (e.code === \"Enter\" || e.code === \"Space\" || e.code === INTERACT_CODE);",
						"",
						"    // ------------------------------------------",
						"    // Диалоги",
						"    // ------------------------------------------",
						"    const DIALOG_DATABASE = {",
						"        \"samopicec_1\": { name: \"...\", text: \"...\" },",
						"        \"broken_satellite\": { name: \"...\", text: \"...\" },",
						"        \"npc_1\": {",
						"            name: \"ЧЛЕН ПАРТИИ\",",
						"            text: \"Привет. Ты в норме?\",",
						"            choices: [",
						"                {",
						"                    label: \"Да.\",",
						"                    action: () => openDialog(\"Я бы так не сказал мой дорогой неуспешный дружочек пирожочек.\", [",
						"                        { label: \"Хорошо. Хорошо.\", action: () => openDialog(\"Ну-ну.\") },",
						"                        { label: \"Чего?\", action: () => openDialog(\"...\") }",
						"                    ])",
						"                },",
						"                { label: \"Нет.\", action: () => openDialog(\"Ага, по тебе видно.\") }",
						"            ]",
						"        }",
						"    };",
						"",
						"    function placeTopLeft(inst, x, y) {",
						"        inst.setPosition(x, y);",
						"        const bb = inst.getBoundingBox();",
						"        inst.x += x - bb.left;",
						"        inst.y += y - bb.top;",
						"    }",
						"",
						"    let dialogPages = [];",
						"    let dialogPageIndex = 0;",
						"    const dialogDynamic = [];",
						"    let dialogChoiceBoxes = [];",
						"",
						"    function paginateDialogText(rawText) {",
						"        const { maxCharsPerLine, maxLines } = DIALOG_UI;",
						"        const lines = [];",
						"",
						"        for (const paragraph of String(rawText).split(\"\\n\")) {",
						"            const words = paragraph.split(\" \");",
						"            let currentLine = \"\";",
						"",
						"            for (const word of words) {",
						"                if (!currentLine) {",
						"                    currentLine = word;",
						"                } else if (currentLine.length + 1 + word.length <= maxCharsPerLine) {",
						"                    currentLine += \" \" + word;",
						"                } else {",
						"                    lines.push(currentLine);",
						"                    currentLine = word;",
						"                }",
						"            }",
						"            lines.push(currentLine);",
						"        }",
						"",
						"        const pages = [];",
						"        for (let i = 0; i < lines.length; i += maxLines) {",
						"            pages.push(lines.slice(i, i + maxLines).join(\"\\n\"));",
						"        }",
						"        return pages.length ? pages : [\"\"];",
						"    }",
						"",
						"    function makeDialogRect(layerName, x, y, w, h, rgb) {",
						"        const r = runtime.objects.DialogPanel.createInstance(layerName, 0, 0);",
						"        r.width = w;",
						"        r.height = h;",
						"        r.colorRgb = rgb;",
						"        placeTopLeft(r, x, y);",
						"        dialogDynamic.push(r);",
						"    }",
						"",
						"    function makeDialogText(layerName, x, y, w, h, str, rgb, pt = DIALOG_UI.fontPt) {",
						"        const t = runtime.objects.DialogText.createInstance(layerName, 0, 0);",
						"        t.width = w;",
						"        t.height = h + DIALOG_UI.textPad;",
						"        if (pt) t.sizePt = pt;",
						"        t.text = str;",
						"        t.fontColor = rgb;",
						"        placeTopLeft(t, x, y);",
						"        dialogDynamic.push(t);",
						"        return t;",
						"    }",
						"",
						"    function clearDialogUi() {",
						"        for (const inst of dialogDynamic) inst.destroy();",
						"        dialogDynamic.length = 0;",
						"        dialogChoiceBoxes = [];",
						"    }",
						"",
						"    function redrawDialog() {",
						"        clearDialogUi();",
						"        if (!isDialogOpen) return;",
						"        if (!runtime.objects.DialogPanel || !runtime.objects.DialogText) {",
						"            console.warn(\"Диалог: не найдены объекты DialogPanel или DialogText.\");",
						"            return;",
						"        }",
						"",
						"        const layerName = (runtime.layout.getLayer(HINT_LAYER) || player.layer).name;",
						"        const { x, y, w, h, colors } = DIALOG_UI;",
						"        const c = dialogChoices || [];",
						"",
						"        // Рамка и фон окна",
						"        makeDialogRect(layerName, x, y, w, h, colors.border);",
						"        makeDialogRect(layerName, x + 1, y + 1, w - 2, h - 2, colors.bg);",
						"",
						"        // Имя говорящего (если задано)",
						"        let textY = y + 4;",
						"        if (speaker) {",
						"            makeDialogText(layerName, x + 5, textY, w - 10, 10, speaker, colors.name);",
						"            textY += 10;",
						"        }",
						"",
						"        const isLastPage = dialogPageIndex >= dialogPages.length - 1;",
						"        const currentText = dialogPages[dialogPageIndex] || \"\";",
						"        const showChoices = isLastPage && c.length > 0;",
						"",
						"        // Основной текст диалога",
						"        const textH = showChoices ? (h - (textY - y) - 21) : (h - (textY - y) - 4);",
						"        makeDialogText(layerName, x + 5, textY, w - 10, Math.max(10, textH), currentText, colors.text);",
						"",
						"        // Если текст продолжается на следующей странице — индикатор в правом нижнем углу",
						"        if (!isLastPage) {",
						"            makeDialogText(layerName, x + w - 12, y + h - 11, 8, 10, \"...\", colors.select);",
						"        }",
						"",
						"        // Варианты ответа друг под другом на всю ширину окна (только на последней странице)",
						"        if (showChoices) {",
						"            c.slice(0, 2).forEach((choice, i) => {",
						"                const cy = y + h - 21 + i * 10;",
						"                const active = i === selected;",
						"                if (active) makeDialogText(layerName, x + 5, cy, 6, 10, \">\", colors.select);",
						"                const labelInst = makeDialogText(",
						"                    layerName, x + 12, cy, w - 17, 10,",
						"                    choice.label ?? (i === 0 ? \"Да\" : \"Нет\"),",
						"                    active ? colors.select : colors.text",
						"                );",
						"                dialogChoiceBoxes.push({ index: i, inst: labelInst });",
						"            });",
						"        }",
						"    }",
						"",
						"    function openDialog(text = \"Null\", choices = null) {",
						"        clearDialogUi();",
						"        isDialogOpen = true;",
						"        dialogPages = paginateDialogText(text);",
						"        dialogPageIndex = 0;",
						"        dialogChoices = choices;",
						"        selected = 0;",
						"        keys.clear();",
						"        inputCooldown = 0.2;",
						"        if (hint) hint.isVisible = false;",
						"        redrawDialog();",
						"    }",
						"",
						"    function closeDialog() {",
						"        if (!isDialogOpen) return;",
						"        isDialogOpen = false;",
						"        dialogChoices = null;",
						"        keys.clear();",
						"        inputCooldown = 0.2;",
						"        clearDialogUi();",
						"    }",
						"",
						"    // ------------------------------------------",
						"    // Меню инвентаря (отрисовка и управление)",
						"    // ------------------------------------------",
						"    let isInventoryOpen = false;",
						"    let invSelected = 0;",
						"    let invEntries = [];",
						"    const invDynamic = [];",
						"",
						"    function placeTopLeft(inst, x, y) {",
						"        inst.setPosition(x, y);",
						"        const bb = inst.getBoundingBox();",
						"        inst.x += x - bb.left;",
						"        inst.y += y - bb.top;",
						"    }",
						"",
						"    function makeInvRect(layerName, x, y, w, h, rgb) {",
						"        const r = runtime.objects.InvPanel.createInstance(layerName, 0, 0);",
						"        r.width = w;",
						"        r.height = h;",
						"        r.colorRgb = rgb;",
						"        placeTopLeft(r, x, y);",
						"        invDynamic.push(r);",
						"    }",
						"",
						"    function makeInvText(layerName, x, y, w, h, str, rgb, pt = INV_UI.fontPt) {",
						"        const t = runtime.objects.InvText.createInstance(layerName, 0, 0);",
						"        t.width = w;",
						"        t.height = h + INV_UI.textPad;",
						"        if (pt) t.sizePt = pt;",
						"        t.text = str;",
						"        t.fontColor = rgb;",
						"        placeTopLeft(t, x, y);",
						"        invDynamic.push(t);",
						"    }",
						"",
						"    function clearInventoryUi() {",
						"        for (const inst of invDynamic) inst.destroy();",
						"        invDynamic.length = 0;",
						"    }",
						"",
						"    function buildInventoryEntries() {",
						"        const counts = {};",
						"        for (const id of inventory) counts[id] = (counts[id] || 0) + 1;",
						"        return Object.entries(counts).map(([id, count]) => ({",
						"            id,",
						"            count,",
						"            label: count > 1 ? `${id} x${count}` : id",
						"        }));",
						"    }",
						"",
						"    function redrawInventory() {",
						"        clearInventoryUi();",
						"        if (!isInventoryOpen) return;",
						"        if (!runtime.objects.InvPanel || !runtime.objects.InvText) {",
						"            console.warn(\"Инвентарь: не найдены объекты InvPanel или InvText.\");",
						"            return;",
						"        }",
						"",
						"        const layerName = (runtime.layout.getLayer(HINT_LAYER) || player.layer).name;",
						"        const { x, y, w, h, lineHeight, maxVisible, colors } = INV_UI;",
						"",
						"        // Рамка и фон окна",
						"        makeInvRect(layerName, x, y, w, h, colors.border);",
						"        makeInvRect(layerName, x + 1, y + 1, w - 2, h - 2, colors.bg);",
						"",
						"        // Заголовок",
						"        makeInvText(layerName, x + 5, y + 4, w - 10, 10, \"ИНВЕНТАРЬ\", colors.title);",
						"",
						"        invEntries = buildInventoryEntries();",
						"        if (invEntries.length === 0) {",
						"            makeInvText(layerName, x + 5, y + 18, w - 10, 12, \"Пусто\", colors.hint);",
						"        } else {",
						"            invSelected = Math.max(0, Math.min(invSelected, invEntries.length - 1));",
						"            const start = Math.min(",
						"                Math.max(0, invSelected - (maxVisible - 1)),",
						"                Math.max(0, invEntries.length - maxVisible)",
						"            );",
						"            for (let k = 0; k < maxVisible && start + k < invEntries.length; k++) {",
						"                const idx = start + k;",
						"                const rowY = y + 17 + k * lineHeight;",
						"                const active = idx === invSelected;",
						"                if (active) makeInvText(layerName, x + 4, rowY, 6, 10, \">\", colors.select);",
						"                makeInvText(layerName, x + 11, rowY, w - 15, 10, invEntries[idx].label, active ? colors.select : colors.text);",
						"            }",
						"        }",
						"",
						"        // Подсказка управления внизу окна",
						"        makeInvText(layerName, x + 5, y + h - 12, w - 10, 10, \"E/Enter: исп.  Esc/I: закр.\", colors.hint, INV_UI.hintFontPt);",
						"    }",
						"",
						"    function openInventory() {",
						"        if (isInventoryOpen || isDialogOpen) return;",
						"        isInventoryOpen = true;",
						"        invSelected = 0;",
						"        keys.clear();",
						"        inputCooldown = 0.2;",
						"        if (hint) hint.isVisible = false;",
						"        redrawInventory();",
						"    }",
						"",
						"    function closeInventory() {",
						"        if (!isInventoryOpen) return;",
						"        isInventoryOpen = false;",
						"        keys.clear();",
						"        inputCooldown = 0.2;",
						"        clearInventoryUi();",
						"    }",
						"",
						"    function useSelectedInventoryItem() {",
						"        if (invEntries.length === 0) return;",
						"        const entry = invEntries[invSelected];",
						"",
						"        // Использование Аптечки",
						"        if (entry.id === \"Аптечка\") {",
						"            const hero = globalThis.gameParty?.[0];",
						"            if (!hero) {",
						"                closeInventory();",
						"                speaker = \"ИНВЕНТАРЬ\";",
						"                openDialog(\"Аптечка: здоровье в норме (500 HP).\");",
						"                return;",
						"            }",
						"            if (hero.hp >= hero.maxHp) {",
						"                closeInventory();",
						"                speaker = \"ИНВЕНТАРЬ\";",
						"                openDialog(\"Здоровье уже полное.\");",
						"                return;",
						"            }",
						"            inventory.splice(inventory.indexOf(entry.id), 1);",
						"            hero.hp = Math.min(hero.maxHp, hero.hp + 40);",
						"            redrawInventory();",
						"            return;",
						"        }",
						"",
						"        // Заглушка для ключей и прочих предметов (позже сюда добавим карточки умений)",
						"        closeInventory();",
						"        speaker = \"ПРЕДМЕТ\";",
						"        openDialog(`${entry.id}: нельзя использовать здесь.`);",
						"    }",
						"",
						"    function pickChoice(index) {",
						"        const action = dialogChoices?.[index]?.action;",
						"        closeDialog();",
						"        if (action) action();",
						"    }",
						"",
						"    // ------------------------------------------",
						"    // Взаимодействие",
						"    // ------------------------------------------",
						"",
						"    function findInteractionTarget() {",
						"        const checkX = player.x + facingX * TILE;",
						"        const checkY = player.y + facingY * TILE;",
						"",
						"        let best = null;",
						"        let bestDist = Infinity;",
						"        for (const obj of interactables) {",
						"            const dFront = Math.hypot(checkX - obj.x, checkY - obj.y);",
						"            const dNear = Math.hypot(player.x - obj.x, player.y - obj.y);",
						"            const d = Math.min(dFront, dNear);",
						"            if (d <= TILE * 1.5 && d < bestDist) { best = obj; bestDist = d; }",
						"        }",
						"        if (best) return { kind: \"object\", obj: best };",
						"",
						"        bestDist = Infinity;",
						"        for (const item of items) {",
						"            const d = Math.hypot(player.x - item.x, player.y - item.y);",
						"            if (d <= TILE * 1.2 && d < bestDist) { best = item; bestDist = d; }",
						"        }",
						"        return best ? { kind: \"item\", obj: best } : null;",
						"    }",
						"",
						"    function startBattle(enemy) {",
						"        state.returnPos = { x: player.x, y: player.y };",
						"        state.returnFacing = { x: facingX, y: facingY };",
						"        globalThis.battleContext = {",
						"            enemyKey: entityKey(enemy),",
						"            enemyType: enemy.instVars?.EnemyType || \"default\",",
						"            returnLayout: layoutName,",
						"            background: layoutName",
						"        };",
						"        leaving = true;",
						"        keys.clear();",
						"        runtime.goToLayout(BATTLE_LAYOUT);",
						"    }",
						"",
						"    function removeObject(obj, list) {",
						"        markRemoved(obj);",
						"        obj.destroy();",
						"        const i = list.indexOf(obj);",
						"        if (i !== -1) list.splice(i, 1);",
						"    }",
						"",
						"    function interact({ kind, obj }) {",
						"        if (kind === \"item\") {",
						"            inventory.push(obj.instVars.ItemType);",
						"            removeObject(obj, items);",
						"            return;",
						"        }",
						"",
						"        if (obj.objectType.name === \"Enemy\") {",
						"            speaker = \"ДЕЙСТВИЕ\";",
						"            openDialog(\"Начать бой?\", [",
						"                { label: \"Да\", action: () => startBattle(obj) },",
						"                { label: \"Нет\", action: () => {} }",
						"            ]);",
						"            return;",
						"        }",
						"",
						"        // Объект с замком (дверь)",
						"        if (obj.instVars && obj.instVars.requiredItem !== undefined) {",
						"            const required = obj.instVars.requiredItem;",
						"            speaker = \"ДЕЙСТВИЕ\";",
						"            if (inventory.includes(required)) {",
						"                openDialog(`Доступ разрешен.\\nИспользован: ${required}`);",
						"                removeObject(obj, interactables);",
						"            } else {",
						"                openDialog(`Заперто.\\nНеобходим предмет: ${required}`);",
						"            }",
						"            return;",
						"        }",
						"",
						"        // Остальное: диалоги",
						"        const data = DIALOG_DATABASE[obj.instVars?.dialogId || \"default\"];",
						"        if (!data) { speaker = \"ОШИБКА\"; openDialog(\"Запись повреждена.\"); return; }",
						"        if (typeof data === \"string\") { speaker = \"НЕИЗВЕСТНО\"; openDialog(data); return; }",
						"        speaker = data.name || \"\";",
						"        openDialog(data.text, data.choices);",
						"    }",
						"",
						"    function updateHint() {",
						"        if (!hint) return;",
						"        const target = (!isDialogOpen && !isInventoryOpen && !tm.isMoving) ? findInteractionTarget() : null;",
						"        if (!target) { hint.isVisible = false; lastHintObj = null; return; }",
						"",
						"        const obj = target.obj;",
						"        if (DEBUG && obj !== lastHintObj) log(\"Подсказка:\", obj.objectType.name, \"слой\", obj.layer.name);",
						"        lastHintObj = obj;",
						"",
						"        const bb = obj.getBoundingBox();",
						"        const cx = (bb.left + bb.right) / 2;",
						"        const toHintLayer = wy => hint.layer.cssPxToLayer(...obj.layer.layerToCssPx(cx, wy));",
						"        const [hx, hyTop] = toHintLayer(bb.top);",
						"",
						"        hint.setPosition(hx, hyTop);",
						"        let hb = hint.getBoundingBox();",
						"        hint.x += hx - (hb.left + hb.right) / 2;      // по центру объекта",
						"        hint.y += (hyTop - 1) - hb.bottom;            // над объектом (не зависит от точки привязки)",
						"",
						"        hb = hint.getBoundingBox();",
						"        if (hb.top < hint.layer.getViewport().top) {",
						"            const [, hyBottom] = toHintLayer(bb.bottom);",
						"            hint.y += (hyBottom + 1) - hb.top;",
						"        }",
						"        hint.isVisible = true;",
						"    }",
						"",
						"    // ------------------------------------------",
						"    // Пропасть, движение, камера",
						"    // ------------------------------------------",
						"    function checkAbyss() {",
						"        let near = false;",
						"        for (const abyss of abysses) {",
						"            const bb = abyss.getBoundingBox();",
						"            const nx = Math.max(bb.left, Math.min(player.x, bb.right));",
						"            const ny = Math.max(bb.top, Math.min(player.y, bb.bottom));",
						"            if (Math.hypot(player.x - nx, player.y - ny) <= TILE * 1.2) { near = true; break; }",
						"        }",
						"        if (near && !nearAbyss) {",
						"            speaker = \"ДЕЙСТВИЕ\";",
						"            openDialog(\"Прыгнуть?\", [",
						"                { label: \"Да\", action: () => runtime.goToLayout(\"Level_1\") },",
						"                { label: \"Нет\", action: () => {} }",
						"            ]);",
						"        }",
						"        nearAbyss = near;",
						"    }",
						"",
						"    const MOVES = [",
						"        { codes: [\"ArrowLeft\", \"KeyA\"],  dir: \"left\",  fx: -1, fy: 0 },",
						"        { codes: [\"ArrowRight\", \"KeyD\"], dir: \"right\", fx: 1,  fy: 0 },",
						"        { codes: [\"ArrowUp\", \"KeyW\"],    dir: \"up\",    fx: 0,  fy: -1 },",
						"        { codes: [\"ArrowDown\", \"KeyS\"],  dir: \"down\",  fx: 0,  fy: 1 }",
						"    ];",
						"    function handleMovement() {",
						"        if (inputCooldown > 0) return;",
						"        const move = MOVES.find(m => m.codes.some(code => keys.has(code)));",
						"        if (!move) return;",
						"        facingX = move.fx;",
						"        facingY = move.fy;",
						"        tm.simulateControl(move.dir);",
						"    }",
						"",
						"    function followCamera(dt) {",
						"        const k = 5 * dt;",
						"        const x = runtime.layout.scrollX;",
						"        const y = runtime.layout.scrollY;",
						"        runtime.layout.scrollTo(Math.round(x + (player.x - x) * k), Math.round(y + (player.y - y) * k));",
						"    }",
						"",
						"    // ------------------------------------------",
						"    // Обработчики",
						"    // ------------------------------------------",
						"    globalThis.currentLayoutTick = () => {",
						"        if (leaving) return;",
						"        const dt = runtime.dt;",
						"        inputCooldown = Math.max(0, inputCooldown - dt);",
						"        if (isDialogOpen || isInventoryOpen) return;",
						"",
						"        checkAbyss();",
						"        handleMovement();",
						"        updateHint();",
						"        followCamera(dt);",
						"    };",
						"",
						"    globalThis.currentLayoutKeyDown = e => {",
						"        if (leaving || inputCooldown > 0) return;",
						"",
						"        if (isDialogOpen) {",
						"            const isLastPage = dialogPageIndex >= dialogPages.length - 1;",
						"",
						"            if (e.code === \"Escape\") {",
						"                closeDialog();",
						"            } else if (!isLastPage) {",
						"                if (isConfirm(e)) {",
						"                    dialogPageIndex++;",
						"                    redrawDialog();",
						"                }",
						"            } else if (dialogChoices && dialogChoices.length > 0) {",
						"                if (isUp(e.code) || e.code === \"ArrowLeft\" || e.code === \"KeyA\") {",
						"                    selected = 0;",
						"                    redrawDialog();",
						"                } else if ((isDown(e.code) || e.code === \"ArrowRight\" || e.code === \"KeyD\") && dialogChoices.length > 1) {",
						"                    selected = 1;",
						"                    redrawDialog();",
						"                } else if (isConfirm(e)) {",
						"                    pickChoice(selected);",
						"                }",
						"            } else if (isConfirm(e)) {",
						"                closeDialog();",
						"            }",
						"            return;",
						"        }",
						"",
						"        if (isInventoryOpen) {",
						"            if (e.code === \"Escape\" || (e.code === INV_KEY && !e.repeat)) closeInventory();",
						"            else if (isUp(e.code) && invEntries.length > 0) {",
						"                invSelected = (invSelected - 1 + invEntries.length) % invEntries.length;",
						"                redrawInventory();",
						"            } else if (isDown(e.code) && invEntries.length > 0) {",
						"                invSelected = (invSelected + 1) % invEntries.length;",
						"                redrawInventory();",
						"            } else if (isConfirm(e)) {",
						"                useSelectedInventoryItem();",
						"            }",
						"            return;",
						"        }",
						"",
						"        if (e.code === INV_KEY && !e.repeat) {",
						"            openInventory();",
						"            return;",
						"        }",
						"",
						"        if (e.code === INTERACT_CODE && !e.repeat) {",
						"            const target = findInteractionTarget();",
						"            if (target) interact(target);",
						"        }",
						"    };",
						"",
						"    globalThis.currentLayoutPointerDown = e => {",
						"        if (e.button !== 0 || leaving || inputCooldown > 0 || !isDialogOpen) return;",
						"        if (dialogPageIndex < dialogPages.length - 1) {",
						"            dialogPageIndex++;",
						"            redrawDialog();",
						"            return;",
						"        }",
						"        if (!dialogChoices || dialogChoices.length === 0) return closeDialog();",
						"",
						"        for (const item of dialogChoiceBoxes) {",
						"            if (!isDialogOpen) return;",
						"            const [x, y] = item.inst.layer.cssPxToLayer(e.clientX, e.clientY);",
						"            if (item.inst.containsPoint(x, y)) {",
						"                pickChoice(item.index);",
						"                return;",
						"            }",
						"        }",
						"    };",
						"",
						"    log(\"Макет запущен:\", layoutName);",
						"}"
					]
				}
			],
			"sid": 897819424656422
		}
	],
	"sid": 951204323471381
}