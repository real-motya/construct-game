{
	"name": "Event Battle",
	"events": [
		{
			"eventType": "block",
			"conditions": [
				{
					"id": "on-start-of-layout",
					"objectClass": "System",
					"sid": 946739592140289
				}
			],
			"actions": [
				{
					"type": "script",
					"language": "javascript",
					"script": [
						"// ==========================================",
						"// МАКЕТ БОЯ (Battle)",
						"// ==========================================",
						"",
						"// ---------- Роутер ввода ----------",
						"if (typeof globalThis.gameEngineInitialized === \"undefined\") {",
						"    globalThis.gameEngineInitialized = true;",
						"    globalThis.gameInventory = [];",
						"    globalThis.gameKeys = new Set();",
						"",
						"    runtime.addEventListener(\"keydown\", e => {",
						"        globalThis.gameKeys.add(e.code);",
						"        if (globalThis.currentLayoutKeyDown) globalThis.currentLayoutKeyDown(e);",
						"    });",
						"    runtime.addEventListener(\"keyup\", e => globalThis.gameKeys.delete(e.code));",
						"    runtime.addEventListener(\"pointerdown\", e => {",
						"        if (globalThis.currentLayoutPointerDown) globalThis.currentLayoutPointerDown(e);",
						"    });",
						"    runtime.addEventListener(\"tick\", () => {",
						"        if (globalThis.currentLayoutTick) globalThis.currentLayoutTick();",
						"    });",
						"}",
						"globalThis.levelState = globalThis.levelState || {};",
						"",
						"globalThis.currentLayoutTick = null;",
						"globalThis.currentLayoutKeyDown = null;",
						"globalThis.currentLayoutPointerDown = null;",
						"globalThis.gameKeys.clear();",
						"",
						"// ==========================================",
						"// ДАННЫЕ (всё, что правится при балансе, лежит здесь; цифры пока временные)",
						"// ==========================================",
						"",
						"// Цвет фона боя по уровню (позже можно заменить спрайтом)",
						"const BACKGROUNDS = {",
						"    \"Level_0\": [0.10, 0.10, 0.12],",
						"    \"Level_1\": [0.07, 0.16, 0.08],",
						"    \"default\": [0.08, 0.08, 0.10]",
						"};",
						"",
						"const DEATH_LAYOUT = \"DeathScreen\";",
						"",
						"// Шрифт интерфейса.",
						"// если текст крупный или обрезан, уменьшать FONT_PT (null = как в объекте BattleText).",
						"const FONT_PT = 6;",
						"const TEXT_PAD = 4;   // запас по высоте: строка шрифта выше самих букв",
						"",
						"// Press Turn в \"половинках\" иконки (целая иконка = 2)",
						"const COST_NORMAL = 2;   // обычное действие",
						"const COST_HALF = 1;     // слабость или крит",
						"const COST_FAIL = 4;     // промах, блок (дополнительная иконка)",
						"",
						"const DAMAGE_TYPE_NAMES = { cut: \"Руб.\", gun: \"Огн.\", blunt: \"Дроб.\", holy: \"Свят.\", occult: \"Окк.\" };",
						"const MENU = [\"Атака\", \"Предмет\", \"Анализ\", \"Побег\"];",
						"",
						"const COLORS = {",
						"    white: [1, 1, 1], gray: [0.5, 0.5, 0.5], red: [0.95, 0.25, 0.25],",
						"    blue: [0.35, 0.6, 1], yellow: [1, 0.85, 0.2], panel: [0.04, 0.05, 0.04]",
						"};",
						"",
						"if (!runtime.objects.BattleText || !runtime.objects.BattlePanel) {",
						"    console.warn(\"Battle: создайте объекты BattleText (Text) и BattlePanel (Sprite).\");",
						"} else {",
						"    initBattle();",
						"}",
						"",
						"function initBattle() {",
						"    const LAYER = 0;",
						"    const DB = globalThis.DB;",
						"    const inventory = globalThis.gameInventory;",
						"",
						"    // Если макет запущен напрямую из редактора, берём тестовый контекст",
						"    const ctx = globalThis.battleContext || {",
						"        enemyKey: null, enemyType: \"default\", returnLayout: \"Level_0\", background: \"Level_0\"",
						"    };",
						"",
						"    if (globalThis.initPartyIfNeeded) globalThis.initPartyIfNeeded();",
						"    const party = globalThis.gameParty;",
						"    const enemyTemplate = DB.ENEMIES[ctx.enemyType] || DB.ENEMIES.default;",
						"    const enemy = {",
						"        ...enemyTemplate,",
						"        maxHp: enemyTemplate.hp,",
						"        affinities: { ...(enemyTemplate.affinities || {}) },",
						"        skills: [...(enemyTemplate.skills || [])],",
						"        drops: [...(enemyTemplate.drops || [])]",
						"    };",
						"",
						"    // ------------------------------------------",
						"    // Рисование",
						"    // ------------------------------------------",
						"    const dynamic = [];   // пересоздаётся при каждой перерисовке",
						"",
						"    // выравнивание по левому верхнему углу независимо от точки привязки",
						"    function place(inst, x, y) {",
						"        inst.setPosition(x, y);",
						"        const bb = inst.getBoundingBox();",
						"        inst.x += x - bb.left;",
						"        inst.y += y - bb.top;",
						"    }",
						"    function makeRect(x, y, w, h, rgb) {",
						"        const r = runtime.objects.BattlePanel.createInstance(LAYER, 0, 0);",
						"        r.width = w;",
						"        r.height = h;",
						"        r.colorRgb = rgb;",
						"        place(r, x, y);",
						"    }",
						"    function makeText(x, y, w, h, str, rgb) {",
						"        const t = runtime.objects.BattleText.createInstance(LAYER, 0, 0);",
						"        t.width = w;",
						"        t.height = h + TEXT_PAD;",
						"        if (FONT_PT) t.sizePt = FONT_PT;",
						"        t.text = str;",
						"        t.fontColor = rgb;",
						"        place(t, x, y);",
						"        return t;",
						"    }",
						"    function box(x, y, w, h) {",
						"        makeRect(x, y, w, h, COLORS.white);",
						"        makeRect(x + 1, y + 1, w - 2, h - 2, COLORS.panel);",
						"    }",
						"    const drawText = (...args) => dynamic.push(makeText(...args));",
						"",
						"    // Статичная часть",
						"    makeRect(0, 0, 160, 144, BACKGROUNDS[ctx.background] || BACKGROUNDS.default);",
						"    box(1, 1, 158, 27);                 // сообщения",
						"    box(1, 88, 78, 55);                 // статы партии",
						"    box(80, 88, 79, 55);                // меню",
						"    makeRect(104, 42, 36, 40, COLORS.red);   // враг (заглушка до появления спрайта)",
						"",
						"    // ------------------------------------------",
						"    // Состояние боя",
						"    // ------------------------------------------",
						"    let mode = \"msg\";          // \"msg\" | \"menu\" | \"sub\"",
						"    let side = \"player\";       // \"player\" | \"enemy\"",
						"    let messageText = \"\";",
						"    let onMsgDone = null;",
						"    let units = 0;             // оставшиеся \"половинки\" иконок игрока",
						"    let enemyUnits = 0;",
						"    let activeIdx = 0;",
						"    let menuIndex = 0;",
						"    let subIndex = 0;",
						"    let subKind = \"attack\";",
						"    let subItems = [];",
						"    let ended = false;",
						"    let inputCooldown = 0.3;",
						"",
						"    const alive = () => party.filter(m => m.hp > 0);",
						"    const active = () => party[activeIdx];",
						"    function nextAliveIdx(from) {",
						"        for (let k = 1; k <= party.length; k++) {",
						"            const idx = (from + k) % party.length;",
						"            if (party[idx].hp > 0) return idx;",
						"        }",
						"        return from;",
						"    }",
						"",
						"    function redraw() {",
						"        for (const inst of dynamic) inst.destroy();",
						"        dynamic.length = 0;",
						"",
						"        drawText(4, 3, 152, 24, messageText, COLORS.white);",
						"        drawText(92, 30, 66, 9, enemy.name, COLORS.white);",
						"        drawText(4, 30, 84, 9, `HP: ${enemy.hp}/${enemy.maxHp}`, COLORS.red);",
						"",
						"        // партия: имя, HP (красным), SP (синим)",
						"        party.forEach((m, i) => {",
						"            const y = 91 + i * 12;",
						"            const isAlive = m.hp > 0;",
						"            if (side === \"player\" && i === activeIdx && isAlive) drawText(3, y, 8, 10, \">\", COLORS.yellow);",
						"            drawText(9, y, 26, 10, m.name, isAlive ? COLORS.white : COLORS.gray);",
						"            drawText(32, y, 26, 10, String(m.hp), isAlive ? COLORS.red : COLORS.gray);",
						"            drawText(54, y, 8, 10, \"\\\\\", COLORS.white);",
						"            drawText(60, y, 26, 10, String(m.sp), COLORS.blue);",
						"        });",
						"",
						"        // меню (окно из 4 строк)",
						"        if (mode === \"msg\") return;",
						"        const list = mode === \"menu\" ? MENU : subItems.map(s => s.label);",
						"        const sel = mode === \"menu\" ? menuIndex : subIndex;",
						"        const start = Math.min(Math.max(0, sel - 3), Math.max(0, list.length - 4));",
						"        for (let k = 0; k < 4 && start + k < list.length; k++) {",
						"            const y = 91 + k * 11;",
						"            const selected = start + k === sel;",
						"            if (selected) drawText(83, y, 6, 10, \">\", COLORS.yellow);",
						"            drawText(90, y, 66, 10, list[start + k], selected ? COLORS.yellow : COLORS.white);",
						"        }",
						"    }",
						"",
						"    // ------------------------------------------",
						"    // Сообщения",
						"    // ------------------------------------------",
						"    function say(text, next) {",
						"        messageText = text;",
						"        mode = \"msg\";",
						"        onMsgDone = next || null;",
						"        redraw();",
						"    }",
						"    function advance() {",
						"        const callback = onMsgDone;",
						"        onMsgDone = null;",
						"        inputCooldown = 0.1;",
						"        if (callback) callback();",
						"    }",
						"",
						"    // ------------------------------------------",
						"    // Конец боя",
						"    // ------------------------------------------",
						"    function leave() {",
						"        ended = true;",
						"        globalThis.currentLayoutKeyDown = null;",
						"        globalThis.currentLayoutPointerDown = null;",
						"        globalThis.currentLayoutTick = null;",
						"        globalThis.gameKeys.clear();",
						"        runtime.goToLayout(ctx.returnLayout);",
						"    }",
						"    function victory() {",
						"        const dropped = (enemy.drops || []).find(d => Math.random() < d.chance);",
						"        const finish = () => {",
						"            const levelState = globalThis.levelState[ctx.returnLayout];",
						"            if (levelState && ctx.enemyKey) levelState.removed.add(ctx.enemyKey);",
						"            leave();",
						"        };",
						"",
						"        say(`${enemy.name} повержен.`, () => {",
						"            if (dropped && DB.SKILLS[dropped.skillId]) {",
						"                inventory.push(`card:${dropped.skillId}`);",
						"                say(`Получена карточка:\\n${DB.SKILLS[dropped.skillId].name}`, finish);",
						"            } else {",
						"                finish();",
						"            }",
						"        });",
						"    }",
						"    function defeat() {",
						"        say(\"Партия пала...\", () => {",
						"            ended = true;",
						"            runtime.goToLayout(DEATH_LAYOUT);",
						"        });",
						"    }",
						"",
						"    // ------------------------------------------",
						"    // Ход игрока",
						"    // ------------------------------------------",
						"    function startPlayerTurn() {",
						"        side = \"player\";",
						"        units = alive().length * COST_NORMAL;",
						"        activeIdx = party.findIndex(m => m.hp > 0);",
						"        showMenu(true);",
						"    }",
						"    function showMenu(resetIndex) {",
						"        messageText = `Ход: ${active().name}`;",
						"        mode = \"menu\";",
						"        if (resetIndex) menuIndex = 0;",
						"        redraw();",
						"    }",
						"    function afterPlayerAction(cost) {",
						"        if (enemy.hp <= 0) return victory();",
						"        if (alive().length === 0) return defeat();",
						"        units -= cost;",
						"        if (units <= 0) return startEnemyTurn();",
						"        activeIdx = nextAliveIdx(activeIdx);",
						"        showMenu(true);",
						"    }",
						"",
						"    function performAttack(attacker, skill) {",
						"        if (skill.costType === \"hp_pct\") {",
						"            const hpCost = Math.max(1, Math.floor(attacker.maxHp * (skill.cost || 0) / 100));",
						"            if (attacker.hp <= hpCost) return say(\"Недостаточно HP.\", () => showMenu(false));",
						"            attacker.hp -= hpCost;",
						"        } else {",
						"            const spCost = skill.costType === \"sp\" ? (skill.cost || 0) : (skill.sp || 0);",
						"            if (spCost > (attacker.sp || 0)) return say(\"Недостаточно SP.\", () => showMenu(false));",
						"            attacker.sp = (attacker.sp || 0) - spCost;",
						"        }",
						"",
						"        const affinity = enemy.affinities[skill.type] || \"normal\";",
						"        let cost = COST_NORMAL;",
						"        let text = `${attacker.name}: ${skill.name}\\n`;",
						"",
						"        if (Math.random() > (skill.accuracy ?? 1)) {",
						"            text += \"Промах!\";",
						"            cost = COST_FAIL;",
						"        } else if (affinity === \"null\") {",
						"            text += \"Не действует!\";",
						"            cost = COST_FAIL;",
						"        } else if (affinity === \"repel\") {",
						"            const back = Math.max(1, Math.round(skill.power || 10));",
						"            attacker.hp = Math.max(0, attacker.hp - back);",
						"            text += `Отражено! Урон: ${back}`;",
						"            cost = COST_FAIL;",
						"        } else {",
						"            let damage = skill.power || 10;",
						"            const tags = [];",
						"            if (affinity === \"vuln\") { damage *= 1.5; cost = COST_HALF; tags.push(\"УЯЗВ.\"); }",
						"            else if (affinity === \"resist\") { damage *= 0.5; tags.push(\"СОПР.\"); }",
						"            if (Math.random() < DB.BALANCE.CRIT_CHANCE) { damage *= 1.5; cost = COST_HALF; tags.push(\"КРИТ\"); }",
						"            damage = Math.max(1, Math.round(damage));",
						"            enemy.hp = Math.max(0, enemy.hp - damage);",
						"            text += `Урон ${damage} ${tags.join(\" \")}`.trim();",
						"        }",
						"        say(text, () => afterPlayerAction(cost));",
						"    }",
						"",
						"    function analyze() {",
						"        const groups = { vuln: [], resist: [], null: [], repel: [] };",
						"        for (const [type, affinity] of Object.entries(enemy.affinities)) {",
						"            if (groups[affinity]) groups[affinity].push(DAMAGE_TYPE_NAMES[type] || type);",
						"        }",
						"        const join = list => list.length ? list.join(\",\") : \"-\";",
						"        let text = `${enemy.name}\\nУязв: ${join(groups.vuln)} Сопр: ${join(groups.resist)}`;",
						"        if (groups.null.length || groups.repel.length) {",
						"            text += `\\nНуль: ${join(groups.null)} Отр: ${join(groups.repel)}`;",
						"        }",
						"        say(text, () => showMenu(false));   // анализ иконку не тратит",
						"    }",
						"",
						"    function tryEscape() {",
						"        if (enemy.canEscape === false) return say(\"Сбежать невозможно.\", () => showMenu(false));",
						"        if (Math.random() < DB.BALANCE.ESCAPE_CHANCE) say(\"Вы сбежали.\", leave);",
						"        else say(\"Не удалось сбежать.\", () => afterPlayerAction(COST_NORMAL));",
						"    }",
						"",
						"    function openSubMenu(kind, entries) {",
						"        subKind = kind;",
						"        subItems = entries;",
						"        subIndex = 0;",
						"        mode = \"sub\";",
						"        redraw();",
						"    }",
						"",
						"    function chooseMain(index) {",
						"        if (index === 0) {",
						"            const member = active();",
						"            const entries = member.skills",
						"                .map(id => DB.SKILLS[id])",
						"                .filter(Boolean)",
						"                .map(s => {",
						"                    const costLabel = s.costType === \"hp_pct\" ? `${s.cost}%HP` : (s.cost ? `${s.cost}SP` : \"\");",
						"                    return { label: costLabel ? `${s.name} ${costLabel}` : s.name, skill: s };",
						"                });",
						"            openSubMenu(\"attack\", entries);",
						"        } else if (index === 1) {",
						"            const counts = {};",
						"            for (const name of inventory) if (DB.ITEMS[name]?.battleUsable) counts[name] = (counts[name] || 0) + 1;",
						"            const names = Object.keys(counts);",
						"            if (names.length === 0) return say(\"Нет предметов.\", () => showMenu(false));",
						"            openSubMenu(\"item\", names.map(n => ({ label: counts[n] > 1 ? `${n} x${counts[n]}` : n, item: n })));",
						"        } else if (index === 2) {",
						"            analyze();",
						"        } else {",
						"            tryEscape();",
						"        }",
						"    }",
						"",
						"    function chooseSub() {",
						"        const member = active();",
						"        const entry = subItems[subIndex];",
						"        if (subKind === \"attack\") return performAttack(member, entry.skill);",
						"",
						"        const heal = DB.ITEMS[entry.item].heal;",
						"        inventory.splice(inventory.indexOf(entry.item), 1);",
						"        member.hp = Math.min(member.maxHp, member.hp + heal);",
						"        say(`${member.name}: ${entry.item}\\nHP +${heal}`, () => afterPlayerAction(COST_NORMAL));",
						"    }",
						"",
						"    // ------------------------------------------",
						"    // Ход противника",
						"    // ------------------------------------------",
						"    function startEnemyTurn() {",
						"        side = \"enemy\";",
						"        enemyUnits = COST_NORMAL;   // один противник = одна иконка",
						"        enemyAct();",
						"    }",
						"    function enemyAct() {",
						"        if (enemyUnits <= 0) return startPlayerTurn();",
						"",
						"        const targets = alive();",
						"        const target = targets[Math.floor(Math.random() * targets.length)];",
						"        const skillId = enemy.skills[Math.floor(Math.random() * enemy.skills.length)];",
						"        const skill = DB.SKILLS[skillId] || { name: \"Удар\", power: 20, accuracy: 0.9 };",
						"",
						"        let cost = COST_NORMAL;",
						"        let text = `${enemy.name}: ${skill.name}\\n`;",
						"        if (Math.random() > (skill.accuracy ?? 0.9)) {",
						"            text += `${target.name}: мимо!`;",
						"            cost = COST_FAIL;",
						"        } else {",
						"            const damage = Math.max(1, Math.round(skill.power));",
						"            target.hp = Math.max(0, target.hp - damage);",
						"            text += `${target.name}: урон ${damage}${target.hp <= 0 ? \" (пал)\" : \"\"}`;",
						"        }",
						"        say(text, () => {",
						"            enemyUnits -= cost;",
						"            if (alive().length === 0) return defeat();",
						"            enemyAct();",
						"        });",
						"    }",
						"",
						"    // ------------------------------------------",
						"    // Ввод",
						"    // ------------------------------------------",
						"    globalThis.currentLayoutKeyDown = e => {",
						"        if (ended || inputCooldown > 0) return;",
						"",
						"        const confirm = (e.code === \"Enter\" || e.code === \"Space\" || e.code === \"KeyE\") && !e.repeat;",
						"        const up = e.code === \"ArrowUp\" || e.code === \"KeyW\";",
						"        const down = e.code === \"ArrowDown\" || e.code === \"KeyS\";",
						"",
						"        if (mode === \"msg\") {",
						"            if (confirm) advance();",
						"            return;",
						"        }",
						"",
						"        if (up || down) {",
						"            const length = mode === \"menu\" ? MENU.length : subItems.length;",
						"            const step = up ? -1 : 1;",
						"            if (mode === \"menu\") menuIndex = (menuIndex + step + length) % length;",
						"            else subIndex = (subIndex + step + length) % length;",
						"            redraw();",
						"        } else if (confirm) {",
						"            if (mode === \"menu\") chooseMain(menuIndex);",
						"            else chooseSub();",
						"        } else if (e.code === \"Escape\" && mode === \"sub\") {",
						"            showMenu(false);",
						"        }",
						"    };",
						"",
						"    globalThis.currentLayoutPointerDown = e => {",
						"        if (!ended && e.button === 0 && inputCooldown <= 0 && mode === \"msg\") advance();",
						"    };",
						"",
						"    globalThis.currentLayoutTick = () => {",
						"        inputCooldown = Math.max(0, inputCooldown - runtime.dt);",
						"    };",
						"",
						"    // ------------------------------------------",
						"    // Старт",
						"    // ------------------------------------------",
						"    say(`${enemy.name} преграждает путь!`, startPlayerTurn);",
						"}"
					]
				}
			],
			"sid": 652648163571536
		}
	],
	"sid": 638103906824489
}