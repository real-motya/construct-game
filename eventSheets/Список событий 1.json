{
	"name": "Список событий 1",
	"events": [
		{
			"eventType": "block",
			"conditions": [
				{
					"id": "on-start-of-layout",
					"objectClass": "System",
					"sid": 135430325690594
				}
			],
			"actions": [
				{
					"type": "script",
					"language": "javascript",
					"script": [
						"// ==========================================",
						"// СТАРТОВЫЕ КООРДИНАТЫ МАКЕТОВ",
						"// ==========================================",
						"const LEVEL_STARTS = {",
						"    \"Level_0\": { x: 18, y: 40 }, ",
						"    \"Level_1\": { x: 80, y: 72 }  ",
						"};",
						"",
						"// ==========================================",
						"// ГЛОБАЛЬНЫЕ ПЕРЕМЕННЫЕ",
						"// ==========================================",
						"if (typeof globalThis.gameInventory === \"undefined\") {",
						"    globalThis.gameInventory = [];",
						"    globalThis.gamePlayerHP = 5;",
						"    globalThis.gameListeners = {};",
						"}",
						"",
						"const player = runtime.objects.Player ? runtime.objects.Player.getFirstInstance() : null;",
						"let damageCooldown = 0;",
						"",
						"console.log(\"HP игрока:\", globalThis.gamePlayerHP);",
						"",
						"if (!player) {",
						"    console.log(\"Ошибка: объект Player не найден на макете.\");",
						"} else {",
						"    const inventory = globalThis.gameInventory;",
						"    let playerHP = globalThis.gamePlayerHP;",
						"    const currentLayout = runtime.layout.name; ",
						"",
						"    // ==========================================",
						"    // ТЕКСТЫ И ДИАЛОГИ",
						"    // ==========================================",
						"    const DIALOG_DATABASE = {",
						"        \"samopicec_1\": {",
						"            name: \"...\",",
						"            text: \"...\"",
						"        },",
						"        \"broken_satellite\": {",
						"            name: \"...\",",
						"            text: \"...\"",
						"        },",
						"        \"npc_1\": {",
						"            name: \"ЧЛЕН ПАРТИИ\",",
						"            text: \"Привет. Ты в норме?\",",
						"            choices: [",
						"                {",
						"                    label: \"Да.\",",
						"                    action: () => {",
						"                        openDialog(\"Я бы так не сказал.\", [",
						"                            {",
						"                                label: \"Хорошо.\",",
						"                                action: () => {",
						"                                    openDialog(\"Ну-ну.\"); ",
						"                                }",
						"                            },",
						"                            {",
						"                                label: \"Чего?\",",
						"                                action: () => {",
						"                                    openDialog(\"...\"); ",
						"                                }",
						"                            }",
						"                        ]); ",
						"                    }",
						"                },",
						"                {",
						"                    label: \"Нет.\",",
						"                    action: () => {",
						"                        openDialog(\"Ага, по тебе видно.\");",
						"                    }",
						"                }",
						"            ]",
						"        }",
						"    };",
						"",
						"    const INTERACTABLE_TYPES = [",
						"        \"Inspectable\",",
						"        \"Samopicec\",",
						"        \"broken_satellite\",",
						"        \"NPC\",",
						"        \"Door\"",
						"    ];",
						"",
						"    const tileSize = 8;",
						"    const playerSpeed = 60;",
						"    const enemySpeed = 60;",
						"    const keys = new Set();",
						"",
						"    // Игровые объекты",
						"    const walls = runtime.objects.Wall ? runtime.objects.Wall.getAllInstances() : [];",
						"    const invisibleWalls = runtime.objects.InvisibleWall ? runtime.objects.InvisibleWall.getAllInstances() : [];",
						"    const enemies = runtime.objects.Enemy ? runtime.objects.Enemy.getAllInstances() : [];",
						"    const items = runtime.objects.Item ? runtime.objects.Item.getAllInstances() : [];",
						"    const abysses = runtime.objects.abyss ? runtime.objects.abyss.getAllInstances() : [];",
						"    const doors = runtime.objects.Door ? runtime.objects.Door.getAllInstances() : [];",
						"",
						"    const interactables = [];",
						"    for (const typeName of INTERACTABLE_TYPES) {",
						"        if (runtime.objects[typeName]) {",
						"            interactables.push(...runtime.objects[typeName].getAllInstances());",
						"        }",
						"    }",
						"",
						"    // Элементы интерфейса",
						"    const hud = runtime.objects.HUDText ? runtime.objects.HUDText.getFirstInstance() : null;",
						"    if (hud) hud.isVisible = true; ",
						"    ",
						"    const deathPanel = runtime.objects.DeathPanel ? runtime.objects.DeathPanel.getFirstInstance() : null;",
						"    const deathTitleText = runtime.objects.DeathTitleText ? runtime.objects.DeathTitleText.getFirstInstance() : null;",
						"    const respawnButton = runtime.objects.RespawnButton ? runtime.objects.RespawnButton.getFirstInstance() : null;",
						"    const exitButton = runtime.objects.ExitButton ? runtime.objects.ExitButton.getFirstInstance() : null;",
						"    const respawnText = runtime.objects.RespawnText ? runtime.objects.RespawnText.getFirstInstance() : null;",
						"    const exitText = runtime.objects.ExitText ? runtime.objects.ExitText.getFirstInstance() : null;",
						"",
						"    const dialogPanel = runtime.objects.DialogPanel ? runtime.objects.DialogPanel.getFirstInstance() : null;",
						"    const dialogText = runtime.objects.DialogText ? runtime.objects.DialogText.getFirstInstance() : null;",
						"    const dialogNameText = runtime.objects.DialogNameText ? runtime.objects.DialogNameText.getFirstInstance() : null; ",
						"    const dialogChoice1 = runtime.objects.DialogChoice1 ? runtime.objects.DialogChoice1.getFirstInstance() : null;",
						"    const dialogChoice2 = runtime.objects.DialogChoice2 ? runtime.objects.DialogChoice2.getFirstInstance() : null;",
						"    const choice1Text = runtime.objects.Choice1Text ? runtime.objects.Choice1Text.getFirstInstance() : null;",
						"    const choice2Text = runtime.objects.Choice2Text ? runtime.objects.Choice2Text.getFirstInstance() : null;",
						"",
						"    // Курсоры",
						"    const dialogCursor = runtime.objects.DialogCursor ? runtime.objects.DialogCursor.getFirstInstance() : null;",
						"    let selectedChoiceIndex = 0;",
						"",
						"    const deathCursor = runtime.objects.DeathCursor ? runtime.objects.DeathCursor.getFirstInstance() : null;",
						"    let selectedDeathChoiceIndex = 0;",
						"",
						"    function updateCursorPosition() {",
						"        if (!dialogCursor) return;",
						"        const offset = 10;",
						"        if (selectedChoiceIndex === 0 && dialogChoice1) {",
						"            dialogCursor.y = dialogChoice1.y;",
						"            dialogCursor.x = dialogChoice1.getBoundingBox().left - offset;",
						"        } else if (selectedChoiceIndex === 1 && dialogChoice2) {",
						"            dialogCursor.y = dialogChoice2.y;",
						"            dialogCursor.x = dialogChoice2.getBoundingBox().left - offset;",
						"        }",
						"    }",
						"",
						"    function updateDeathCursorPosition() {",
						"        if (!deathCursor) return;",
						"        const offset = 10;",
						"        if (selectedDeathChoiceIndex === 0 && respawnButton) {",
						"            deathCursor.y = respawnButton.y;",
						"            deathCursor.x = respawnButton.getBoundingBox().left - offset;",
						"        } else if (selectedDeathChoiceIndex === 1 && exitButton) {",
						"            deathCursor.y = exitButton.y;",
						"            deathCursor.x = exitButton.getBoundingBox().left - offset;",
						"        }",
						"    }",
						"",
						"    let spawnX = player.x;",
						"    let spawnY = player.y;",
						"",
						"    if (LEVEL_STARTS[currentLayout]) {",
						"        spawnX = LEVEL_STARTS[currentLayout].x;",
						"        spawnY = LEVEL_STARTS[currentLayout].y;",
						"        player.setPosition(spawnX, spawnY);",
						"    }",
						"",
						"    let isDead = false;",
						"    let isDialogOpen = false;",
						"    let currentDialogChoices = null;",
						"    let currentSpeakerName = \"\"; ",
						"    let nearAbyssTriggered = false;",
						"",
						"    const uiTypesToHide = [",
						"        runtime.objects.DeathPanel, runtime.objects.DeathTitleText, ",
						"        runtime.objects.RespawnButton, runtime.objects.ExitButton, ",
						"        runtime.objects.RespawnText, runtime.objects.ExitText,",
						"        runtime.objects.DialogPanel, runtime.objects.DialogText, runtime.objects.DialogNameText,",
						"        runtime.objects.DialogChoice1, runtime.objects.DialogChoice2, ",
						"        runtime.objects.Choice1Text, runtime.objects.Choice2Text,",
						"        runtime.objects.DialogCursor, ",
						"        runtime.objects.DeathCursor",
						"    ];",
						"",
						"    for (const type of uiTypesToHide) {",
						"        if (type) {",
						"            for (const inst of type.getAllInstances()) inst.isVisible = false;",
						"        }",
						"    }",
						"    for (const wall of invisibleWalls) wall.isVisible = false;",
						"    for (const abyss of abysses) abyss.isVisible = false;",
						"",
						"    const enemyStates = new Map();",
						"    for (const enemy of enemies) {",
						"        enemyStates.set(enemy, {",
						"            moving: false,",
						"            targetX: enemy.x,",
						"            targetY: enemy.y,",
						"            timer: 0,",
						"            hp: 2",
						"        });",
						"    }",
						"",
						"    let playerMoving = false;",
						"    let playerTargetX = spawnX;",
						"    let playerTargetY = spawnY;",
						"",
						"    let facingX = 0;",
						"    let facingY = 1;",
						"    let attackCooldown = 0;",
						"    let inputCooldown = 0; ",
						"",
						"    // ==========================================",
						"    // СИСТЕМА ДИАЛОГОВ",
						"    // ==========================================",
						"    function openDialog(text = \"Null\", choices = null) {",
						"        if (isDead || isDialogOpen) return;",
						"",
						"        isDialogOpen = true;",
						"        currentDialogChoices = choices;",
						"        keys.clear();",
						"        playerMoving = false;",
						"        inputCooldown = 0.2; ",
						"",
						"        if (dialogPanel) dialogPanel.isVisible = true;",
						"        if (dialogText) {",
						"            dialogText.isVisible = true;",
						"            dialogText.text = text;",
						"        }",
						"",
						"        if (dialogNameText) {",
						"            if (currentSpeakerName) {",
						"                dialogNameText.isVisible = true;",
						"                dialogNameText.text = currentSpeakerName;",
						"            } else {",
						"                dialogNameText.isVisible = false;",
						"            }",
						"        }",
						"",
						"        if (choices && choices.length > 0) {",
						"            if (dialogChoice1) {",
						"                dialogChoice1.isVisible = true;",
						"                if (choice1Text) {",
						"                    choice1Text.isVisible = true;",
						"                    choice1Text.text = choices[0].label || \"Да\";",
						"                }",
						"            }",
						"            if (choices.length > 1 && dialogChoice2) {",
						"                dialogChoice2.isVisible = true;",
						"                if (choice2Text) {",
						"                    choice2Text.isVisible = true;",
						"                    choice2Text.text = choices[1].label || \"Нет\";",
						"                }",
						"            } else {",
						"                if (dialogChoice2) dialogChoice2.isVisible = false;",
						"                if (choice2Text) choice2Text.isVisible = false;",
						"            }",
						"            ",
						"            selectedChoiceIndex = 0; ",
						"            if (dialogCursor) {",
						"                dialogCursor.isVisible = true;",
						"                updateCursorPosition();",
						"            }",
						"        } else {",
						"            if (dialogChoice1) dialogChoice1.isVisible = false;",
						"            if (dialogChoice2) dialogChoice2.isVisible = false;",
						"            if (choice1Text) choice1Text.isVisible = false;",
						"            if (choice2Text) choice2Text.isVisible = false;",
						"            if (dialogCursor) dialogCursor.isVisible = false;",
						"        }",
						"    }",
						"",
						"    function closeDialog() {",
						"        if (!isDialogOpen) return;",
						"",
						"        isDialogOpen = false;",
						"        currentDialogChoices = null;",
						"        keys.clear();",
						"        inputCooldown = 0.2; ",
						"",
						"        if (dialogPanel) dialogPanel.isVisible = false;",
						"        if (dialogText) dialogText.isVisible = false;",
						"        if (dialogNameText) dialogNameText.isVisible = false;",
						"        if (dialogChoice1) dialogChoice1.isVisible = false;",
						"        if (dialogChoice2) dialogChoice2.isVisible = false;",
						"        if (choice1Text) choice1Text.isVisible = false;",
						"        if (choice2Text) choice2Text.isVisible = false;",
						"        if (dialogCursor) dialogCursor.isVisible = false;",
						"    }",
						"",
						"    // ==========================================",
						"    // СИСТЕМА СМЕРТИ И ВОЗРОЖДЕНИЯ",
						"    // ==========================================",
						"    function showDeathMenu() {",
						"        if (isDead) return;",
						"",
						"        isDead = true;",
						"        closeDialog();",
						"",
						"        keys.clear();",
						"        playerMoving = false;",
						"        player.isVisible = false;",
						"        player.isCollisionEnabled = false;",
						"",
						"        if (deathPanel) deathPanel.isVisible = true;",
						"        if (deathTitleText) deathTitleText.isVisible = true;",
						"        if (respawnButton) respawnButton.isVisible = true;",
						"        if (exitButton) exitButton.isVisible = true;",
						"        if (respawnText) respawnText.isVisible = true;",
						"        if (exitText) exitText.isVisible = true;",
						"",
						"        if (hud) hud.isVisible = false;",
						"",
						"        selectedDeathChoiceIndex = 0;",
						"        if (deathCursor) {",
						"            deathCursor.isVisible = true;",
						"            updateDeathCursorPosition();",
						"        }",
						"    }",
						"",
						"    function respawnPlayer() {",
						"        if (!isDead) return;",
						"",
						"        player.setPosition(spawnX, spawnY);",
						"",
						"        playerHP = 5;",
						"        globalThis.gamePlayerHP = playerHP;",
						"",
						"        damageCooldown = 0;",
						"        attackCooldown = 0;",
						"        playerTargetX = spawnX;",
						"        playerTargetY = spawnY;",
						"        playerMoving = false;",
						"        facingX = 0;",
						"        facingY = 1;",
						"",
						"        player.isVisible = true;",
						"        player.isCollisionEnabled = true;",
						"",
						"        if (deathPanel) deathPanel.isVisible = false;",
						"        if (deathTitleText) deathTitleText.isVisible = false;",
						"        if (respawnButton) respawnButton.isVisible = false;",
						"        if (exitButton) exitButton.isVisible = false;",
						"        if (respawnText) respawnText.isVisible = false;",
						"        if (exitText) exitText.isVisible = false;",
						"        ",
						"        if (deathCursor) deathCursor.isVisible = false;",
						"        if (hud) hud.isVisible = true;",
						"",
						"        keys.clear();",
						"        isDead = false;",
						"    }",
						"",
						"    // ==========================================",
						"    // КОЛЛИЗИИ",
						"    // ==========================================",
						"    function hitsWall(object, x, y) {",
						"        const oldX = object.x;",
						"        const oldY = object.y;",
						"        const oldW = object.width;",
						"        const oldH = object.height;",
						"",
						"        object.x = x;",
						"        object.y = y;",
						"        ",
						"        object.width = Math.max(4, oldW - 4);",
						"        object.height = Math.max(4, oldH - 4);",
						"",
						"        const hitWall = walls.some(wall => runtime.collisions.testOverlap(object, wall));",
						"        const hitInvisible = invisibleWalls.some(barrier => runtime.collisions.testOverlap(object, barrier));",
						"        const hitDoor = doors.some(door => runtime.collisions.testOverlap(object, door));",
						"",
						"        object.x = oldX;",
						"        object.y = oldY;",
						"        object.width = oldW;",
						"        object.height = oldH;",
						"",
						"        return hitWall || hitInvisible || hitDoor;",
						"    }",
						"",
						"    function hitsPlayer(object, x, y) {",
						"        const oldX = object.x;",
						"        const oldY = object.y;",
						"        const oldW = object.width;",
						"        const oldH = object.height;",
						"",
						"        object.x = x;",
						"        object.y = y;",
						"        object.width = Math.max(4, oldW - 4);",
						"        object.height = Math.max(4, oldH - 4);",
						"",
						"        const result = runtime.collisions.testOverlap(object, player);",
						"",
						"        object.x = oldX;",
						"        object.y = oldY;",
						"        object.width = oldW;",
						"        object.height = oldH;",
						"",
						"        return result;",
						"    }",
						"",
						"    if (globalThis.gameListeners.tick) {",
						"        runtime.removeEventListener(\"tick\", globalThis.gameListeners.tick);",
						"        runtime.removeEventListener(\"keydown\", globalThis.gameListeners.keydown);",
						"        runtime.removeEventListener(\"keyup\", globalThis.gameListeners.keyup);",
						"        runtime.removeEventListener(\"pointerdown\", globalThis.gameListeners.pointerdown);",
						"    }",
						"",
						"    // ==========================================",
						"    // СОБЫТИЯ ВВОДА",
						"    // ==========================================",
						"    const onPointerDown = e => {",
						"        if (e.button !== 0) return;",
						"",
						"        if (isDead) {",
						"            if (inputCooldown > 0) return; ",
						"            if (respawnButton && respawnButton.isVisible) {",
						"                const [x, y] = respawnButton.layer.cssPxToLayer(e.clientX, e.clientY);",
						"                if (respawnButton.containsPoint(x, y)) {",
						"                    respawnPlayer();",
						"                    return;",
						"                }",
						"            }",
						"            if (exitButton && exitButton.isVisible) {",
						"                const [x, y] = exitButton.layer.cssPxToLayer(e.clientX, e.clientY);",
						"                if (exitButton.containsPoint(x, y)) {",
						"                    runtime.goToLayout(\"MainMenu\");",
						"                    return;",
						"                }",
						"            }",
						"        }",
						"",
						"        if (isDialogOpen) {",
						"            if (inputCooldown > 0) return; ",
						"            if (currentDialogChoices && currentDialogChoices.length > 0) {",
						"                if (dialogChoice1 && dialogChoice1.isVisible) {",
						"                    const [x, y] = dialogChoice1.layer.cssPxToLayer(e.clientX, e.clientY);",
						"                    if (dialogChoice1.containsPoint(x, y)) {",
						"                        const action = currentDialogChoices?.[0]?.action;",
						"                        closeDialog();",
						"                        if (action) action();",
						"                        return;",
						"                    }",
						"                }",
						"                if (dialogChoice2 && dialogChoice2.isVisible) {",
						"                    const [x, y] = dialogChoice2.layer.cssPxToLayer(e.clientX, e.clientY);",
						"                    if (dialogChoice2.containsPoint(x, y)) {",
						"                        const action = currentDialogChoices?.[1]?.action;",
						"                        closeDialog();",
						"                        if (action) action();",
						"                        return;",
						"                    }",
						"                }",
						"            } else {",
						"                closeDialog();",
						"            }",
						"            return;",
						"        }",
						"    };",
						"",
						"    const onKeyDown = e => {",
						"        if (isDead) {",
						"            if (inputCooldown > 0) return; ",
						"            if (e.code === \"Escape\") {",
						"                runtime.goToLayout(\"MainMenu\");",
						"            } else if (e.code === \"ArrowUp\" || e.code === \"KeyW\") {",
						"                selectedDeathChoiceIndex = 0;",
						"                updateDeathCursorPosition();",
						"            } else if (e.code === \"ArrowDown\" || e.code === \"KeyS\") {",
						"                selectedDeathChoiceIndex = 1;",
						"                updateDeathCursorPosition();",
						"            } else if ((e.code === \"Enter\" || e.code === \"Space\" || e.code === \"KeyE\") && !e.repeat) {",
						"                if (selectedDeathChoiceIndex === 0) {",
						"                    respawnPlayer();",
						"                } else if (selectedDeathChoiceIndex === 1) {",
						"                    runtime.goToLayout(\"MainMenu\");",
						"                }",
						"            }",
						"            return;",
						"        }",
						"",
						"        if (isDialogOpen) {",
						"            if (inputCooldown > 0) return; ",
						"            if (e.code === \"Escape\") {",
						"                closeDialog();",
						"            } else if (currentDialogChoices && currentDialogChoices.length > 0) {",
						"                if (e.code === \"ArrowUp\" || e.code === \"KeyW\") {",
						"                    selectedChoiceIndex = 0;",
						"                    updateCursorPosition();",
						"                } else if (e.code === \"ArrowDown\" || e.code === \"KeyS\") {",
						"                    if (currentDialogChoices.length > 1) {",
						"                        selectedChoiceIndex = 1;",
						"                        updateCursorPosition();",
						"                    }",
						"                } else if ((e.code === \"Enter\" || e.code === \"Space\" || e.code === \"KeyE\") && !e.repeat) {",
						"                    const action = currentDialogChoices[selectedChoiceIndex]?.action;",
						"                    closeDialog();",
						"                    if (action) action();",
						"                }",
						"            } else if ((e.code === \"Enter\" || e.code === \"Space\" || e.code === \"KeyE\") && !e.repeat) {",
						"                closeDialog();",
						"            }",
						"            return;",
						"        }",
						"",
						"        keys.add(e.code);",
						"",
						"        if (e.code === \"KeyE\" && !e.repeat) {",
						"            if (inputCooldown > 0) return; ",
						"            ",
						"            let nearestInteractable = null;",
						"            let closestInteractableDist = Infinity;",
						"",
						"            for (const obj of interactables) {",
						"                const distance = Math.hypot(player.x - obj.x, player.y - obj.y);",
						"                if (distance <= tileSize * 1.5 && distance < closestInteractableDist) {",
						"                    closestInteractableDist = distance;",
						"                    nearestInteractable = obj;",
						"                }",
						"            }",
						"",
						"            if (nearestInteractable) {",
						"                if (nearestInteractable.instVars && nearestInteractable.instVars.requiredItem !== undefined) {",
						"                    const required = nearestInteractable.instVars.requiredItem;",
						"                    currentSpeakerName = \"ДЕЙСТВИЕ\";",
						"",
						"                    if (inventory.includes(required)) {",
						"                        openDialog(`Доступ разрешен.\\nИспользован: ${required}`);",
						"                        nearestInteractable.destroy();",
						"                        interactables.splice(interactables.indexOf(nearestInteractable), 1);",
						"                        doors.splice(doors.indexOf(nearestInteractable), 1);",
						"                    } else {",
						"                        openDialog(`Заперто.\\nНеобходим предмет: ${required}`);",
						"                    }",
						"                    return;",
						"                }",
						"",
						"                const dialogId = nearestInteractable.instVars?.dialogId || \"default\";",
						"                const dialogData = DIALOG_DATABASE[dialogId];",
						"                ",
						"                if (dialogData) {",
						"                    if (typeof dialogData === \"string\") {",
						"                        currentSpeakerName = \"НЕИЗВЕСТНО\";",
						"                        openDialog(dialogData);",
						"                    } else {",
						"                        currentSpeakerName = dialogData.name || \"\";",
						"                        openDialog(dialogData.text, dialogData.choices);",
						"                    }",
						"                } else {",
						"                    currentSpeakerName = \"ОШИБКА\";",
						"                    openDialog(\"Запись повреждена.\");",
						"                }",
						"                return;",
						"            }",
						"",
						"            let nearestItem = null;",
						"            let closestItemDist = Infinity;",
						"",
						"            for (const item of items) {",
						"                const distance = Math.hypot(player.x - item.x, player.y - item.y);",
						"                if (distance <= tileSize * 1.2 && distance < closestItemDist) {",
						"                    closestItemDist = distance;",
						"                    nearestItem = item;",
						"                }",
						"            }",
						"",
						"            if (nearestItem) {",
						"                inventory.push(nearestItem.instVars.ItemType);",
						"                nearestItem.destroy();",
						"                items.splice(items.indexOf(nearestItem), 1);",
						"                console.log(\"Предмет подобран:\", inventory);",
						"            }",
						"        }",
						"",
						"        if (e.code === \"Space\" && !e.repeat && attackCooldown <= 0) {",
						"            if (inputCooldown > 0) return; ",
						"            ",
						"            attackCooldown = 0.4;",
						"",
						"            let targetEnemy = null;",
						"            let closestDistance = Infinity;",
						"",
						"            for (const enemy of enemies) {",
						"                const distanceToPlayer = Math.hypot(player.x - enemy.x, player.y - enemy.y);",
						"",
						"                if (distanceToPlayer < tileSize && damageCooldown <= 0) {",
						"                    playerHP--;",
						"                    globalThis.gamePlayerHP = playerHP;",
						"                    damageCooldown = 1;",
						"",
						"                    if (playerHP <= 0) {",
						"                        showDeathMenu();",
						"                        return;",
						"                    }",
						"                }",
						"",
						"                const dx = enemy.x - player.x;",
						"                const dy = enemy.y - player.y;",
						"                const forward = dx * facingX + dy * facingY;",
						"                const side = Math.abs(dx * facingY - dy * facingX);",
						"                const distance = Math.hypot(dx, dy);",
						"",
						"                if (forward > 0 && forward <= tileSize * 1.5 && side <= tileSize * 0.6 && distance < closestDistance) {",
						"                    closestDistance = distance;",
						"                    targetEnemy = enemy;",
						"                }",
						"            }",
						"",
						"            if (targetEnemy) {",
						"                const state = enemyStates.get(targetEnemy);",
						"                if (state) {",
						"                    state.hp--;",
						"                    if (state.hp <= 0) {",
						"                        targetEnemy.destroy();",
						"                        enemyStates.delete(targetEnemy);",
						"                        enemies.splice(enemies.indexOf(targetEnemy), 1);",
						"                    }",
						"                }",
						"            }",
						"        }",
						"    };",
						"",
						"    const onKeyUp = e => keys.delete(e.code);",
						"",
						"    // ==========================================",
						"    // ИГРОВОЙ ЦИКЛ (TICK)",
						"    // ==========================================",
						"    const onTick = () => {",
						"        if (respawnButton && respawnText) {",
						"            const bboxR = respawnButton.getBoundingBox();",
						"            respawnText.x = bboxR.left + 3;",
						"            respawnText.y = bboxR.top + 0;",
						"            respawnText.width = bboxR.right - bboxR.left;",
						"            respawnText.height = bboxR.bottom - bboxR.top;",
						"        }",
						"        if (exitButton && exitText) {",
						"            const bboxE = exitButton.getBoundingBox();",
						"            exitText.x = bboxE.left + 3;",
						"            exitText.y = bboxE.top + 0;",
						"            exitText.width = bboxE.right - bboxE.left;",
						"            exitText.height = bboxE.bottom - bboxE.top;",
						"        }",
						"",
						"        const dt = runtime.dt;",
						"        ",
						"        inputCooldown = Math.max(0, inputCooldown - dt);",
						"",
						"        if (isDead || isDialogOpen) return;",
						"",
						"        // Обновление HUD",
						"        if (hud) {",
						"            if (currentLayout === \"Level_0\") {",
						"                hud.text = \"INV: \" + inventory.join(\", \");",
						"            } else {",
						"                hud.text = \"INV: \" + inventory.join(\", \") + \"\\nHP: \" + playerHP;",
						"            }",
						"        }",
						"",
						"        attackCooldown = Math.max(0, attackCooldown - dt);",
						"        damageCooldown = Math.max(0, damageCooldown - dt);",
						"",
						"        // Проверка обрыва",
						"        let isNearAnyAbyss = false;",
						"        for (const abyss of abysses) {",
						"            const bbox = abyss.getBoundingBox();",
						"            const nearestX = Math.max(bbox.left, Math.min(player.x, bbox.right));",
						"            const nearestY = Math.max(bbox.top, Math.min(player.y, bbox.bottom));",
						"            const distance = Math.hypot(player.x - nearestX, player.y - nearestY);",
						"",
						"            if (distance <= tileSize * 1.2) {",
						"                isNearAnyAbyss = true;",
						"",
						"                if (!nearAbyssTriggered) {",
						"                    nearAbyssTriggered = true;",
						"                    currentSpeakerName = \"ДЕЙСТВИЕ\"; ",
						"                    openDialog(\"Прыгнуть?\", [",
						"                        {",
						"                            label: \"Да\",",
						"                            action: () => {",
						"                                runtime.goToLayout(\"Level_1\");",
						"                            }",
						"                        },",
						"                        {",
						"                            label: \"Нет\",",
						"                            action: () => {",
						"                                console.log(\"Прыжок отменен.\");",
						"                            }",
						"                        }",
						"                    ]);",
						"                }",
						"                break;",
						"            }",
						"        }",
						"",
						"        if (!isNearAnyAbyss) {",
						"            nearAbyssTriggered = false;",
						"        }",
						"",
						"        // Движение игрока",
						"        if (playerMoving) {",
						"            const dx = playerTargetX - player.x;",
						"            const dy = playerTargetY - player.y;",
						"            const distance = Math.hypot(dx, dy);",
						"            const step = playerSpeed * dt;",
						"",
						"            if (distance <= step) {",
						"                player.x = playerTargetX;",
						"                player.y = playerTargetY;",
						"                playerMoving = false;",
						"            } else {",
						"                player.x += (dx / distance) * step;",
						"                player.y += (dy / distance) * step;",
						"            }",
						"        } else {",
						"            let dx = 0, dy = 0;",
						"",
						"            if (keys.has(\"ArrowLeft\") || keys.has(\"KeyA\")) dx = -1;",
						"            else if (keys.has(\"ArrowRight\") || keys.has(\"KeyD\")) dx = 1;",
						"            else if (keys.has(\"ArrowUp\") || keys.has(\"KeyW\")) dy = -1;",
						"            else if (keys.has(\"ArrowDown\") || keys.has(\"KeyS\")) dy = 1;",
						"",
						"            if (dx !== 0 || dy !== 0) {",
						"                facingX = dx;",
						"                facingY = dy;",
						"                const nextX = player.x + dx * tileSize;",
						"                const nextY = player.y + dy * tileSize;",
						"",
						"                if (!hitsWall(player, nextX, nextY)) {",
						"                    playerTargetX = nextX;",
						"                    playerTargetY = nextY;",
						"                    playerMoving = true;",
						"                }",
						"            }",
						"        }",
						"",
						"        // Движение и логика врагов",
						"        for (const enemy of enemies) {",
						"            const state = enemyStates.get(enemy);",
						"            if (!state) continue;",
						"",
						"            const distanceToPlayer = Math.hypot(player.x - enemy.x, player.y - enemy.y);",
						"",
						"            if (distanceToPlayer <= tileSize * 1.1 && damageCooldown <= 0) {",
						"                playerHP--;",
						"                globalThis.gamePlayerHP = playerHP;",
						"                damageCooldown = 1;",
						"",
						"                if (playerHP <= 0) {",
						"                    showDeathMenu();",
						"                    return;",
						"                }",
						"            }",
						"",
						"            if (state.moving) {",
						"                const dx = state.targetX - enemy.x;",
						"                const dy = state.targetY - enemy.y;",
						"                const distance = Math.hypot(dx, dy);",
						"                const step = enemySpeed * dt;",
						"",
						"                if (distance <= step) {",
						"                    enemy.x = state.targetX;",
						"                    enemy.y = state.targetY;",
						"                    state.moving = false;",
						"                } else {",
						"                    enemy.x += (dx / distance) * step;",
						"                    enemy.y += (dy / distance) * step;",
						"                }",
						"                continue;",
						"            }",
						"",
						"            state.timer -= dt;",
						"            if (state.timer > 0) continue;",
						"",
						"            state.timer = 0.6;",
						"            const chaseDistance = Math.abs(player.x - enemy.x) + Math.abs(player.y - enemy.y);",
						"            if (chaseDistance > tileSize * 6) continue;",
						"",
						"            const directions = [];",
						"            if (Math.abs(player.x - enemy.x) >= Math.abs(player.y - enemy.y)) {",
						"                directions.push([Math.sign(player.x - enemy.x), 0], [0, Math.sign(player.y - enemy.y)]);",
						"            } else {",
						"                directions.push([0, Math.sign(player.y - enemy.y)], [Math.sign(player.x - enemy.x), 0]);",
						"            }",
						"",
						"            for (const [dx, dy] of directions) {",
						"                if (dx === 0 && dy === 0) continue;",
						"                const nextX = enemy.x + dx * tileSize;",
						"                const nextY = enemy.y + dy * tileSize;",
						"",
						"                if (hitsWall(enemy, nextX, nextY)) continue;",
						"                if (hitsPlayer(enemy, nextX, nextY)) continue;",
						"",
						"                state.targetX = nextX;",
						"                state.targetY = nextY;",
						"                state.moving = true;",
						"                break;",
						"            }",
						"        }",
						"        ",
						"        // Плавная камера",
						"        const camX = runtime.layout.scrollX;",
						"        const camY = runtime.layout.scrollY;",
						"        const cameraSpeed = 5; ",
						"",
						"        const targetX = camX + (player.x - camX) * cameraSpeed * dt;",
						"        const targetY = camY + (player.y - camY) * cameraSpeed * dt;",
						"",
						"        runtime.layout.scrollTo(Math.round(targetX), Math.round(targetY));",
						"    };",
						"",
						"    globalThis.gameListeners.pointerdown = onPointerDown;",
						"    globalThis.gameListeners.keydown = onKeyDown;",
						"    globalThis.gameListeners.keyup = onKeyUp;",
						"    globalThis.gameListeners.tick = onTick;",
						"",
						"    runtime.addEventListener(\"pointerdown\", onPointerDown);",
						"    runtime.addEventListener(\"keydown\", onKeyDown);",
						"    runtime.addEventListener(\"keyup\", onKeyUp);",
						"    runtime.addEventListener(\"tick\", onTick);",
						"    ",
						"    console.log(\"Макет запущен:\", currentLayout);",
						"}"
					]
				}
			],
			"sid": 897819424656422
		}
	],
	"sid": 951204323471381
}